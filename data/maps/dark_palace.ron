// Palais des Tenebres
// Stage 5 (Monde des Tenebres) : Kodongos et Eyegores, les Armos reviennent, puis le Roi Helmasaure
// Le boss final apparait a 9:00 ; sa defaite ouvre la porte de sortie (victoire en la franchissant).
// props : decor procedural (density = chance par case de 48 px, solid = bloque Link et la horde).
(
    name: "Palais des Tenebres",
    order: 5,
    music: "dungeon_of_shadows",
    boss_music: "anger_of_the_guardians",
    final_music: "anger_of_the_guardians",
    ground: "dark_palace",
    weather: Dark,
    ambience: None,
    tint: Some((0.25, 0.05, 0.3, 0.12)),
    max_enemies: 4800,
    duration: 540.0,
    // difficulte du stage : vie et degats des ennemis ordinaires
    power: 1.55,
    waves: [
        (enemy: "keese", from: 0.0, to: 900.0, rate: (0.9, 5.0), cap: 400),
        (enemy: "stalfos", from: 15.0, to: 900.0, rate: (0.6, 4.0), cap: 350),
        (enemy: "kodongo", from: 40.0, to: 900.0, rate: (0.3, 2.5), cap: 150),
        (enemy: "hardhat", from: 80.0, to: 900.0, rate: (0.3, 2.5), cap: 180),
        (enemy: "eyegore", from: 140.0, to: 900.0, rate: (0.1, 1.0), cap: 50),
        (enemy: "buzz_blob", from: 200.0, to: 900.0, rate: (0.25, 2.5), cap: 150),
        (enemy: "moblin", from: 260.0, to: 900.0, rate: (0.2, 2.0), cap: 120),
        (enemy: "vulture", from: 330.0, to: 900.0, rate: (0.25, 2.5), cap: 150),
    ],
    bursts: [
        (at: 30.0, enemy: "keese", count: 120, pattern: Pack),
        (at: 75.0, enemy: "stalfos", count: 100, pattern: Ring),
        (at: 130.0, enemy: "kodongo", count: 40, pattern: Pack),
        (at: 200.0, enemy: "hardhat", count: 80, pattern: Ring),
        (at: 260.0, enemy: "eyegore", count: 10, pattern: Ring),
        (at: 330.0, enemy: "stalfos", count: 200, pattern: Ring),
        (at: 410.0, enemy: "keese", count: 220, pattern: Pack),
        (at: 490.0, enemy: "kodongo", count: 80, pattern: Ring),
    ],
    elites: [
        (at: 60.0, enemy: "stalfos"),
        (at: 150.0, enemy: "kodongo"),
        (at: 240.0, enemy: "eyegore"),
        (at: 360.0, enemy: "hardhat"),
        (at: 450.0, enemy: "eyegore"),
    ],
    boss: Some((at: 270.0, enemy: "armos_knight", hp: Some(5500.0))),
    final_boss: Some((at: 540.0, enemy: "helmasaur_king", hp: Some(10500.0))),
    props: [
        (sprite: "prop_tree_dark", density: 0.05, radius: 13.0, solid: true),
        (sprite: "prop_skull", density: 0.015, radius: 10.0, solid: true),
        (sprite: "prop_bush", density: 0.05, radius: 6.0, solid: false, tint: Some((0.45, 0.3, 0.55, 0.4)), breakable: true, break_fx: "fx_bush_break"),
    ],
)
