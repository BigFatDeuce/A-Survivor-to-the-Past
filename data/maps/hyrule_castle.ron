// Chateau d'Hyrule
// Stage 4 (fin du Monde de la Lumiere) : les soldats d'Agahnim, le Chevalier au fleau, puis Agahnim
// Le boss final apparait a 9:00 ; sa defaite ouvre la porte de sortie (victoire en la franchissant).
// props : decor procedural (density = chance par case de 48 px, solid = bloque Link et la horde).
(
    name: "Chateau d'Hyrule",
    order: 4,
    music: "majestic_castle",
    boss_music: "anger_of_the_guardians",
    final_music: "priest_of_the_dark_order",
    ground: "castle",
    weather: Clear,
    ambience: None,
    tint: Some((0.3, 0.3, 0.5, 0.4)),
    max_enemies: 4800,
    duration: 540.0,
    // difficulte du stage : vie et degats des ennemis ordinaires
    power: 1.4,
    waves: [
        (enemy: "soldier_green", from: 0.0, to: 900.0, rate: (1.0, 5.5), cap: 450),
        (enemy: "rat", from: 10.0, to: 900.0, rate: (0.5, 4.0), cap: 300),
        (enemy: "soldier_blue", from: 30.0, to: 900.0, rate: (0.5, 4.0), cap: 350),
        (enemy: "archer", from: 60.0, to: 900.0, rate: (0.2, 1.6), cap: 60),
        (enemy: "keese", from: 90.0, to: 900.0, rate: (0.4, 3.5), cap: 250),
        (enemy: "soldier_red", from: 120.0, to: 900.0, rate: (0.25, 2.2), cap: 120),
        (enemy: "stalfos", from: 200.0, to: 900.0, rate: (0.3, 2.5), cap: 200),
        (enemy: "moblin", from: 300.0, to: 900.0, rate: (0.2, 2.0), cap: 120),
    ],
    bursts: [
        (at: 30.0, enemy: "soldier_green", count: 100, pattern: Ring),
        (at: 80.0, enemy: "rat", count: 120, pattern: Pack),
        (at: 130.0, enemy: "soldier_blue", count: 100, pattern: Ring),
        (at: 190.0, enemy: "keese", count: 150, pattern: Pack),
        (at: 250.0, enemy: "soldier_red", count: 30, pattern: Ring),
        (at: 340.0, enemy: "soldier_blue", count: 220, pattern: Ring),
        (at: 420.0, enemy: "stalfos", count: 180, pattern: Ring),
        (at: 495.0, enemy: "soldier_red", count: 60, pattern: Ring),
    ],
    elites: [
        (at: 60.0, enemy: "soldier_blue"),
        (at: 150.0, enemy: "soldier_red"),
        (at: 240.0, enemy: "archer"),
        (at: 360.0, enemy: "soldier_red"),
        (at: 450.0, enemy: "moblin"),
    ],
    boss: Some((at: 270.0, enemy: "flail_knight", hp: Some(4500.0))),
    final_boss: Some((at: 540.0, enemy: "agahnim", hp: Some(9000.0))),
    props: [
        (sprite: "prop_bush", density: 0.05, radius: 6.0, solid: false, breakable: true, break_fx: "fx_bush_break"),
        (sprite: "prop_boulder", density: 0.015, radius: 12.0, solid: true, tint: Some((0.7, 0.7, 0.8, 0.35))),
        (sprite: "prop_stump", density: 0.01, radius: 9.0, solid: true),
    ],
)
