// Version 0.5 : personnages supplementaires (planches deposees dans AdditionalChars/, copiees dans assets/source/).
// Sonic (style Zelda Game Boy, custom de Ragnarockerbunny, cycle de Blueblur64), Link facon Zelda 1 (edite par
// Mister Mike), Princesse Zelda (Four Swords GBA, extraite par Deathbringer). Credits repris dans le README.
(
    sheets: [
        (
            // grille de 16 px : rangee 0 dos, 1 profil tourne vers la droite, 2 vers la gauche, 3 face
            source: "Custom - Sonic (Zelda Game Boy-Style).png",
            sprites: {
            },
        ),
        (
            // tenue bleue (rangee y 37) ; chaque case a un fond gris fonce
            source: "Custom - Link (Zelda 1-Style).png",
            transparent: ["#008000", "#303030"],
            sprites: {
            },
        ),
        (
            // cadres de hauteur fixe par rangee : les pieds restent en place ; le profil regarde a gauche
            source: "Game Boy Advance - Four Swords - Princess Zelda.png",
            sprites: {
            },
        ),
        (
            // fleche d'indication de la police d'A Link to the Past (pointe a droite) : reperes hors de l'ecran
            source: "Miscellaneous - Fonts.png",
            sprites: {
                "ui_arrow": { "0": (frames: [(165, 114, 13, 14)], pivot: (0, 0), align: Center) },
            },
        ),
    ],
)
