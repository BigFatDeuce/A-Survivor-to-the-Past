                "fx_fog":            { "0": (frames: [(0, 82, 256, 256)], pivot: (0, 0), center_x: false, align: Top) },
                "fx_canopy":         { "0": (frames: [(0, 340, 256, 256)], pivot: (0, 0), center_x: false, align: Top) },
            },
        ),
    ],
    tilesets: [
