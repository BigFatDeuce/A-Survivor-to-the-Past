// Stages : sols (tuiles 16x16 des rendus d'overworld), decor et textures de meteo.
// Le decor est detoure par research/tools/make_props.py (planche assets/source/props/stage_props.png).
// Sols : 0 tuile de base, 1-3 variantes discretes, 4-5 details, 6 detail rare (voir stages::ground_index).
(
    sheets: [
        (
            source: "props/stage_props.png",
            sprites: {
                "prop_tree":         { "0": (frames: [(0, 0, 64, 80)], pivot: (0, -3), align: Bottom) },
                "prop_stump":        { "0": (frames: [(66, 0, 32, 32)], pivot: (0, -2), align: Bottom) },
                "prop_bush":         { "0": (frames: [(100, 0, 16, 16)], pivot: (0, -1), align: Bottom) },
                "prop_skull":        { "0": (frames: [(118, 0, 32, 32)], pivot: (0, -2), align: Bottom) },
                "prop_desert_plant": { "0": (frames: [(152, 0, 16, 24)], pivot: (0, -1), align: Bottom) },
