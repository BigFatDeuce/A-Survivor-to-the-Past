                "fx_spark": { "0": (frames: [(57, 7, 16, 16), (35, 12, 8, 8)], fps: 20, mode: Once, pivot: (0, 0), align: Center) },
                "fx_dust": { "0": (frames: [(146, 4, 8, 8), (146, 18, 8, 8), (173, 19, 8, 8)], fps: 14, mode: Once, pivot: (0, 0), align: Center) },
            },
        ),
        (
            source: "Miscellaneous - HUD.png",
            transparent: ["#3f48cc", "#80ffff"],
            sprites: {
                "hud_heart": {
                    "full":  (frames: [(259, 56, 7, 7)], pivot: (0, 0), center_x: false),
                    "half":  (frames: [(283, 56, 7, 7)], pivot: (0, 0), center_x: false),
                    "empty": (frames: [(291, 56, 7, 7)], pivot: (0, 0), center_x: false),
                },
            },
        ),
    ],
    fonts: [
        // Police principale : planches FRN + GER (accents d'origine), accents ES/IT/PT
        // composes a partir des accents d'origine, kana de la planche JPN.
        // Dessines a la main (absents des planches) : + % / et le tilde de ñ ã õ.
        (
            name: "main",
            top: 2,
            line_h: 14,
            // les lettres commencent bas dans la case (place des accents) : remonte de 2 px
            nudge: -2,
            space: 5,
            spacing: -1,
            accent_rows: 4,
            blocks: [
                (
                    source: "Miscellaneous - Fonts (FRN).png",
                    origin: (32, 0),
                    cell: (8, 16),
                    rows: [
                        "ABCDEFGHIJKLMNOP",
                        "QRSTUVWXYZabcdef",
                        "ghijklmnopqrstuv",
                        "wxyz0123456789!?",
                        "-.,…▶()",
                        "¤'¤¤¤¤¤¤¤¤ö¤¤¤¤ü",
                        "ô:¤¤¤¤èéêàùçâûîä",
                    ],
                ),
                (
                    source: "Miscellaneous - Fonts (GER).png",
                    origin: (32, 0),
                    cell: (8, 16),
                    rows: ["¤", "¤", "¤", "¤", "¤", "¤", "ß¤¤¤¤¤¤¤¤¤¤¤ÄÖÜ"],
                ),
                (
                    source: "Miscellaneous - Font (JPN).png",
                    origin: (0, 0),
                    cell: (11, 16),
                    mono: true,
                    rows: [
                        "あいうえおやゆよかきくけこわをんさしすせそがぎぐたちつてとげござ",
                        "なにぬねのじずぜはひふへほぞだぢまみむめもづでどらりるれろばびぶ",
                        "べぼぱぴぷぺぽゃゅょっぁぃぅぇぉアイウエオヤユヨカキクケコワヲン",
                        "サシスセソガギグタチツテトゲゴザナニヌネノジズゼハヒフヘホゾダヂ",
                        "マミムメモヅデドラリルレロバビブベボパピプペポャュョッァィゥェォ",
                        "¤",
                        "¤¤¤¤「」？！、ー¤¤¤。～",
                    ],
                ),
            ],
            compose: [
                Accent('á', 'a', 'é'), Accent('í', 'i', 'é'), Accent('ó', 'o', 'é'), Accent('ú', 'u', 'é'),
                Accent('ì', 'i', 'è'), Accent('ò', 'o', 'è'),
                Accent('ë', 'e', 'ä'), Accent('ï', 'i', 'ä'),
                // majuscules accentuees (absentes des planches) : accent pose au-dessus, comme Ä
                AccentCap('À', 'A', 'à'), AccentCap('Á', 'A', 'é'), AccentCap('Â', 'A', 'â'),
                AccentCap('É', 'E', 'é'), AccentCap('È', 'E', 'è'), AccentCap('Ê', 'E', 'ê'),
                AccentCap('Í', 'I', 'é'), AccentCap('Î', 'I', 'î'),
                AccentCap('Ó', 'O', 'é'), AccentCap('Ô', 'O', 'ô'),
                AccentCap('Ú', 'U', 'é'), AccentCap('Ù', 'U', 'ù'), AccentCap('Û', 'U', 'û'),
                AccentArt('ñ', 'n', [".oo.o", "o..o."]),
                AccentArt('ã', 'a', [".oo.o", "o..o."]),
                AccentArt('õ', 'o', [".oo.o", "o..o."]),
                Rotate('¿', '?'), Rotate('¡', '!'), Rotate('◀', '▶'),
                Art('+', 4, ["..o..", "..o..", "ooooo", "..o..", "..o.."]),
                Art('/', 3, ["...o", "...o", "..o.", "..o.", "..o.", ".o..", ".o..", ".o..", "o...", "o..."]),
                Art('%', 3, ["oo...o", "oo...o", "....o.", "...o..", "...o..", "..o...", "..o...", ".o....", "o...oo", "o...oo"]),
            ],
        ),
        (
            name: "hud",
            line_h: 7,
            space: 4,
            blocks: [
                (
                    source: "Miscellaneous - HUD.png",
                    transparent: ["#3f48cc", "#80ffff"],
                    origin: (259, 13),
                    cell: (8, 8),
                    rows: ["01234", "56789"],
                ),
            ],
        ),
    ],
    tilesets: [
        (
            name: "grass",
            source: "Overworld - Light World.png",
            size: 16,
            // 0 herbe nue, 1-3 touffes, 4-6 fleurs (pas de buisson peint au sol : les buissons sont des decors cassables)
            tiles: [(2408, 3708), (2408, 3724), (2408, 3772), (2312, 3836), (2424, 3740), (2408, 3756), (2408, 3756)],
        ),
    ],
)
