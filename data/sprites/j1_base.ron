                    "walk_up":   (frames: [(81, 179, 12, 16), (97, 179, 12, 16)], fps: 8, pivot: (0, -1), align: Bottom),
                },
                "keese": {
                    "fly": (frames: [(140, 106, 12, 14), (169, 106, 12, 13), (186, 106, 16, 13)], fps: 12, mode: PingPong, pivot: (0, 0), align: Center),
                },
                "tektite": {
                    "idle": (frames: [(141, 21, 28, 17), (174, 21, 28, 17)], fps: 4, pivot: (0, -1), align: Bottom),
                    "jump": (frames: [(208, 22, 24, 16)], pivot: (0, -1), align: Bottom),
                },
                "crow": {
                    "idle": (frames: [(9, 62, 16, 17)], pivot: (0, -1), align: Bottom),
                    "fly": (frames: [(8, 103, 16, 15), (31, 102, 16, 16)], fps: 8, pivot: (0, 0), align: Center),
