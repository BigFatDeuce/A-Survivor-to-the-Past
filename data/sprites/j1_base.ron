            sprites: {
                "rupee_green": { "0": (frames: [(36, 249, 8, 14), (52, 249, 8, 14), (68, 249, 8, 14)], fps: 6, mode: PingPong, pivot: (0, -1), align: Bottom) },
                "rupee_blue":  { "0": (frames: [(84, 249, 8, 14), (100, 249, 8, 14), (116, 249, 8, 14)], fps: 6, mode: PingPong, pivot: (0, -1), align: Bottom) },
                "rupee_red":   { "0": (frames: [(132, 249, 8, 14), (148, 249, 8, 14), (164, 249, 8, 14)], fps: 6, mode: PingPong, pivot: (0, -1), align: Bottom) },
                "heart_small": { "0": (frames: [(88, 280, 8, 7)], pivot: (0, -1), align: Bottom) },
