                "chest_small": { "closed": (frames: [(88, 224, 16, 16)], pivot: (0, -1), align: Bottom), "open": (frames: [(112, 224, 16, 16)], pivot: (0, -1), align: Bottom) },
                "chest_big":   { "closed": (frames: [(136, 216, 32, 24)], pivot: (0, -1), align: Bottom), "open": (frames: [(176, 216, 32, 24)], pivot: (0, -1), align: Bottom) },
                "fairy": { "0": (frames: [(152, 272, 16, 16), (176, 272, 16, 16)], fps: 10, pivot: (0, 0), align: Center) },
