// Manifeste d'assets du jalon 1 : Link, premiers ennemis, objets, effets, polices, tuiles.
// Coordonnees (x, y, largeur, hauteur) dans les planches de assets/source/.
// pivot = point d'ancrage (les pieds) ; voir crates/assetkit/src/manifest.rs.
(
    sheets: [
        (
            source: "Playable Characters - Link.png",
            transparent: ["#008080", "#004040"],
            sprites: {
                "link": {
                    // frame 0 = immobile, 1..7 = cycle de marche (ALttP : 8 frames)
                    "idle_down": (frames: [(1, 3, 16, 24)], pivot: (0, -1), align: Bottom),
                    "idle_side": (frames: [(1, 58, 17, 24)], pivot: (0, -1), align: Bottom),
                    "idle_up":   (frames: [(1, 111, 16, 24)], pivot: (0, -1), align: Bottom),
                    "walk_down": (frames: [(19, 3, 16, 24), (36, 2, 16, 25), (53, 1, 16, 26), (70, 3, 16, 24), (87, 3, 16, 24), (104, 2, 16, 25), (121, 1, 16, 26), (1, 3, 16, 24)], fps: 16, pivot: (0, -1), align: Bottom),
                    "walk_side": (frames: [(20, 57, 17, 25), (38, 57, 16, 25), (55, 58, 17, 24), (73, 58, 17, 24), (91, 57, 17, 25), (109, 57, 16, 25), (126, 58, 16, 24), (1, 58, 17, 24)], fps: 16, pivot: (0, -1), align: Bottom),
                    "walk_up":   (frames: [(19, 111, 16, 24), (36, 110, 16, 25), (53, 110, 16, 25), (70, 111, 16, 24), (87, 111, 16, 24), (104, 110, 16, 25), (121, 110, 16, 25), (1, 111, 16, 24)], fps: 16, pivot: (0, -1), align: Bottom),
                },
                // epees horizontales (garde a gauche) : tournees par le moteur pour le coup
                "sword1": { "h": (frames: [(79, 277, 16, 8)], pivot: (1, 4), center_x: false) },
                "sword2": { "h": (frames: [(174, 277, 16, 8)], pivot: (1, 4), center_x: false) },
            },
        ),
        (
            source: "Enemies - Hylian Knights.png",
            transparent: ["#ff00ff", "#f880f8"],
            sprites: {
                "soldier_green": {
                    "walk_down": (frames: [(12, 684, 22, 33), (40, 683, 22, 38), (69, 684, 22, 34), (98, 683, 22, 35)], pivot: (0, 24)),
                    "walk_side": (frames: [(14, 791, 29, 27), (48, 792, 29, 26), (82, 791, 32, 27)], mode: PingPong, pivot: (11, 26), center_x: false),
                    "walk_up":   (frames: [(10, 887, 22, 27), (37, 888, 22, 26), (64, 888, 22, 26), (91, 881, 22, 33)], pivot: (0, -1), align: Bottom),
                },
