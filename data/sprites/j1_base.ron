                    "walk_down": (frames: [(11, 355, 22, 33), (39, 354, 22, 38), (68, 355, 22, 34), (97, 354, 22, 35)], pivot: (0, 24)),
                    "walk_side": (frames: [(13, 462, 29, 27), (47, 463, 29, 26), (81, 462, 32, 27)], mode: PingPong, pivot: (11, 26), center_x: false),
                    "walk_up":   (frames: [(9, 558, 22, 27), (36, 559, 22, 26), (63, 559, 22, 26), (90, 552, 22, 33)], pivot: (0, -1), align: Bottom),
                },
            },
        ),
        (
            source: "Enemies - Minor Light World Enemies.png",
            transparent: ["#ff00ff", "#f880f8"],
            sprites: {
                "rope": {
                    "walk_down": (frames: [(8, 141, 13, 16), (24, 141, 13, 16)], fps: 6, pivot: (0, -1), align: Bottom),
                    "walk_side": (frames: [(42, 141, 15, 16), (62, 141, 16, 16)], fps: 6, pivot: (0, -1), align: Bottom),
                    "walk_up":   (frames: [(82, 141, 12, 16), (99, 141, 12, 16)], fps: 6, pivot: (0, -1), align: Bottom),
