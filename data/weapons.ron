// Armes. Une arme = une famille (kind), des caracteristiques de base (niveau 1) et les
// ameliorations des niveaux suivants. Les noms et descriptions sont dans data/lang/*.ron
// (cles weapon.<id>.name / weapon.<id>.desc) ; le detail des niveaux est genere.
//
// Familles : Swing (epee), Projectile, Boomerang, Lob (bombes), Slam (frappe au sol),
//            Orbit, Pillars (colonnes sur l'ecran), Storm (tout l'ecran),
//            Aura (nuage autour du joueur), Somaria (bloc qui eclate en rayons : beam + rays),
//            Bees (projectiles qui poursuivent les ennemis), Jump (saut invincible + onde de choc),
//            Tornado (tornades qui errent). fan: true = projectiles en eventail ; tint = teinte de l'effet.
// chain: true dessine une chaine entre le joueur et le projectile (grappin).
// Evolution : arme au niveau max + objet passif possede -> l'arme evoluee, dans un coffre.
//
// base : damage, cooldown (s), amount, area (portee / rayon), speed, duration (s),
//        pierce (0 = illimite ; epee = ennemis touches par coup), knockback, crit_chance,
//        crit_mult, hit_interval (s entre deux touches sur un meme ennemi).
// Mods : Damage(+n), Cooldown(-0.1 = -10 %), Amount(+n), Area(+0.1 = +10 %), Speed(..),
//        Duration(..), Pierce(+n), Knockback(..), Crit(+0.05).
{
    "sword": (
        kind: Swing, icon: "icon_sword", sfx: "swing",
        // l'epee seule ne doit pas suffire. Portee courte, 3 cibles par coup.
        base: (damage: 9.0, cooldown: 0.7, area: 24.0, duration: 0.16, pierce: 3,
               knockback: 100.0, crit_chance: 0.08, crit_mult: 1.75),
        // range = distance de declenchement auto : a peine plus que la lame (area + corps ennemi)
        arc: 120.0, range: 32.0,
        levels: [
            [Damage(3.0)],
            [Pierce(1), Area(0.15)],
            [Damage(3.0), Cooldown(-0.1)],
            [Amount(1), Damage(4.0), Area(0.15), Pierce(2)],
        ],
        evolution: Some((passive: "heart_container", into: "combat_sword")),
        // 0.6.3 : fusion ultime, une fois Ganon vaincu (unlock de master_sword)
        ultimate: Some((passive: "mirror_shield", into: "master_sword")),
    ),
    // Epee de combat (epee + receptacle) : l'ancienne Master Sword, 15 % moins forte.
    "combat_sword": (
        kind: Swing, icon: "icon_combat_sword", sfx: "swing_master", evolved: true,
        base: (damage: 20.0, cooldown: 0.5, amount: 2, area: 28.0, duration: 0.15, pierce: 0,
               knockback: 140.0, crit_chance: 0.13, crit_mult: 2.0),
        arc: 140.0, range: 38.0,
        beam: Some((sprite: "beam_master", damage: 0.7, speed: 250.0, life: 0.6)),
    ),
    // Master Sword : fusion ultime (epee + bouclier miroir), debloquee en battant Ganon une premiere fois.
    // Coups : 32 x 2 / 0,45 s = 142 degats/s, environ 25 % de plus que les meilleures fusions (arc
    // d'argent 116, lance-pierre 112), plus le faisceau a pleine puissance, la portee et les critiques.
    "master_sword": (
        kind: Swing, icon: "icon_master_sword", sfx: "swing_master", evolved: true, unlock: Some("ganon"),
        base: (damage: 32.0, cooldown: 0.45, amount: 2, area: 34.0, duration: 0.15, pierce: 0,
               knockback: 170.0, crit_chance: 0.2, crit_mult: 2.25),
        arc: 150.0, range: 44.0,
        beam: Some((sprite: "beam_master", damage: 1.0, speed: 300.0, life: 0.75)),
    ),
