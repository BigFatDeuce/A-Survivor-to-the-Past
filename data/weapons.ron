            [Pierce(1), Cooldown(-0.1)],
            [Amount(1)],
            [Damage(6.0), Pierce(1)],
        ],
        evolution: Some((passive: "quiver", into: "silver_bow")),
    ),
    "silver_bow": (
        kind: Projectile, icon: "icon_silver_bow", sprite: "proj_arrow", sfx: "bow", evolved: true,
