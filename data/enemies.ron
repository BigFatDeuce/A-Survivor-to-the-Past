// Ennemis. vitesse en pixels/s, degats : 1 coeur = 10, xp = valeur en rubis (1 vert, 5 bleu, 20 rouge).
// Noms affiches : data/lang/*.ron (cle enemy.<id>).
// anims : Dir4(prefix, side_faces_left, attack: Some("shoot")), Single("anim") ou Hop(idle, jump).
// scale : agrandissement a l'affichage (1 par defaut, entier pour garder les pixels nets).
// behavior :
//   Chase                                   fonce droit sur le joueur
//   Flutter(amp, freq)                      vol en zigzag (ignore la foule)
//   Hop(rest, jump, speed)                  bonds periodiques
//   Wander(turn)                            flane en se rapprochant
//   Charger(range, windup, speed, time, rest)  s'arrete (annonce) puis charge en ligne droite
//   Shooter(range, keep, cooldown, windup, shot)  garde ses distances et tire
//   Boss(actions: [Walk(s), Charge(..), Throw(..), Summon(..)])  patron en boucle
// Retour J1 : degats au contact releves (foncer dans la foule doit couter cher).
{
    "soldier_green": (
        sprite: "soldier_green", anims: Dir4(prefix: "walk", side_faces_left: false),
        hp: 18.0, speed: 30.0, damage: 10.0, radius: 6.0, mass: 1.0, xp: 1,
        behavior: Chase, shadow: 1,
    ),
    "soldier_blue": (
        sprite: "soldier_blue", anims: Dir4(prefix: "walk", side_faces_left: false),
        hp: 42.0, speed: 33.0, damage: 15.0, radius: 6.5, mass: 1.6, xp: 5,
        behavior: Chase, shadow: 1,
    ),
    "rope": (
        sprite: "rope", anims: Dir4(prefix: "walk", side_faces_left: true),
        hp: 10.0, speed: 40.0, damage: 10.0, radius: 5.0, mass: 0.8, xp: 1,
        behavior: Charger(range: 70.0, windup: 0.35, speed: 125.0, time: 0.45, rest: 0.6), shadow: 0,
    ),
    "rat": (
        sprite: "rat", anims: Dir4(prefix: "walk", side_faces_left: true),
        hp: 6.0, speed: 52.0, damage: 5.0, radius: 4.5, mass: 0.6, xp: 1,
        behavior: Chase, shadow: 0,
    ),
    "keese": (
        sprite: "keese", anims: Single("fly"),
        hp: 6.0, speed: 58.0, damage: 5.0, radius: 5.0, mass: 0.5, xp: 1,
        behavior: Flutter(amp: 0.9, freq: 3.0), flying: true, shadow: 0,
    ),
    "tektite": (
        sprite: "tektite", anims: Hop(idle: "idle", jump: "jump"),
        hp: 26.0, speed: 0.0, damage: 10.0, radius: 7.0, mass: 1.4, xp: 5,
        behavior: Hop(rest: 0.9, jump: 0.45, speed: 120.0), shadow: 2,
    ),
    "octorok": (
        sprite: "octorok", anims: Dir4(prefix: "walk", side_faces_left: true, attack: Some("shoot")),
        hp: 16.0, speed: 34.0, damage: 10.0, radius: 6.0, mass: 1.0, xp: 2,
        behavior: Shooter(range: 170.0, keep: 110.0, cooldown: 2.6, windup: 0.4,
                          shot: (sprite: "shot_rock", speed: 110.0, damage: 10.0, radius: 4.0)),
        shadow: 1,
    ),
    "archer": (
        sprite: "archer", anims: Dir4(prefix: "walk", side_faces_left: false),
        hp: 26.0, speed: 30.0, damage: 10.0, radius: 6.5, mass: 1.2, xp: 3,
        behavior: Shooter(range: 200.0, keep: 140.0, cooldown: 3.0, windup: 0.55,
                          shot: (sprite: "proj_arrow", speed: 165.0, damage: 10.0, radius: 3.0)),
        shadow: 1,
    ),
    "crow": (
        sprite: "crow", anims: Single("fly"),
        hp: 10.0, speed: 45.0, damage: 10.0, radius: 5.0, mass: 0.6, xp: 1,
        behavior: Charger(range: 120.0, windup: 0.5, speed: 165.0, time: 0.6, rest: 0.8), flying: true, shadow: 0,
    ),
    "moblin": (
        sprite: "moblin", anims: Dir4(prefix: "walk", side_faces_left: false),
        hp: 48.0, speed: 28.0, damage: 15.0, radius: 7.0, mass: 1.8, xp: 5,
        behavior: Shooter(range: 150.0, keep: 90.0, cooldown: 3.2, windup: 0.55,
                          shot: (sprite: "shot_spear", speed: 140.0, damage: 15.0, radius: 3.0)),
        shadow: 1,
    ),
    "buzz_blob": (
        sprite: "buzz_blob", anims: Single("walk"),
        hp: 30.0, speed: 22.0, damage: 15.0, radius: 6.0, mass: 1.2, xp: 3,
        behavior: Wander(turn: 1.2), shadow: 1,
    ),
    "popo": (
        sprite: "popo", anims: Single("walk"),
