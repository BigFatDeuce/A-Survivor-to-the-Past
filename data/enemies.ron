    // Boss generique : Hinox (bombes, charge, renforts).
    "hinox": (
        sprite: "hinox", anims: Dir4(prefix: "walk", side_faces_left: false, attack: Some("throw")),
        // affiche en x2 : un boss doit se lire au premier coup d'oeil dans la foule
        hp: 2400.0, speed: 26.0, damage: 20.0, radius: 20.0, mass: 10.0, xp: 0,
        boss: true, shadow: 2, scale: 2.0,
        behavior: Boss(actions: [
            Walk(3.0),
            Throw(windup: 0.6, shot: (sprite: "shot_bomb", speed: 120.0, damage: 20.0, lob: true, radius: 22.0, count: 3, spread: 25.0)),
            Walk(2.5),
            Charge(windup: 0.7, speed: 170.0, time: 0.9),
            Walk(2.0),
            Summon(enemy: "soldier_blue", count: 6),
            Walk(2.0),
            Throw(windup: 0.5, shot: (sprite: "shot_bomb", speed: 130.0, damage: 20.0, lob: true, radius: 22.0, count: 5, spread: 18.0)),
            Charge(windup: 0.55, speed: 190.0, time: 0.8),
        ]),
    ),
