// Crewmate (Among Us, style A Link to the Past) : chanceux, part avec les bombes. Huit couleurs au choix
// (gauche / droite dans l'ecran des personnages). Debloque apres 8000 ennemis vaincus.
(
    name: "Crewmate",
    sprite: "crewmate",
    max_hp: 60.0,
    speed: 86.0,
    radius: 5.0,
    magnet: 40.0,
    dash: (speed: 330.0, duration: 0.15, cooldown: 1.8),
    weapon: "bombs",
    weapon_sprite: "sword1",
    // avantages : chance +25 %, attraction +20 % ; defauts : degats -5 %
    stats: [(Luck, 0.25), (Magnet, 0.2), (Might, -0.05)],
    order: 16,

    group: "games",
    unlock: Some(Kills(8000)),
    // 0.6.5 : sprite du Randomizer (Crewmate), couleurs de ses palettes : gen_zspr_chars.py
    // 0.6.5 : sprite du Randomizer (Crewmate), couleurs de ses palettes : gen_zspr_chars.py
