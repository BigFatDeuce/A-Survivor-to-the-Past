// Audio : musiques (avec points de boucle), regles des effets sonores, et association
// evenement du jeu -> effet(s). Tout se regle ici sans toucher au code.
//
// Musiques : comme dans le jeu d'origine (et son recompile), l'introduction est jouee une fois puis
// la boucle se repete sans couture. Les fichiers sont prepares par research/tools/music_loopify.py :
// ils s'arretent au point de boucle, avec un micro-fondu de 60 ms deja integre ; loop_start et
// loop_end sont au sample pres (32 kHz). `once: true` = jingle joue une fois.
// Une seule musique par contexte (stage, boss, menus), celle que le jeu joue au meme endroit.
(
    // Ecran titre : le prologue d'ALttP (la legende des sept sages), sous une averse continue.
    menu_music: "title_theme",
    menu_ambience: Some("fierce_rainstorm"),
    music: {
        "title_theme": (file: "03_seal_of_seven_maidens.ogg", loop_start: 48.380000, loop_end: Some(95.836000)),
        "title_link_to_the_past": (file: "01_title_link_to_the_past.ogg", loop_start: 9.7056, loop_end: Some(14.5312)),
        "beginning_of_the_journey": (file: "02_beginning_of_the_journey.ogg", loop_start: 12.000000, loop_end: Some(35.832000)),
        "seal_of_seven_maidens": (file: "03_seal_of_seven_maidens.ogg", loop_start: 48.380000, loop_end: Some(95.836000)),
        "time_of_the_falling_rain": (file: "04_time_of_the_falling_rain.ogg", loop_start: 24.011750, loop_end: Some(44.350000)),
        "time_of_the_falling_rain_storm": (file: "05_time_of_the_falling_rain_storm.ogg", loop_start: 10.829313, loop_end: Some(31.170000)),
        "majestic_castle": (file: "06_majestic_castle.ogg", loop_start: 85.099625, loop_end: Some(163.380000)),
        "majestic_castle_storm": (file: "07_majestic_castle_storm.ogg", loop_start: 78.9873, loop_end: Some(161.984)),
        "princess_zelda_s_rescue": (file: "08_princess_zelda_s_rescue.ogg", loop_start: 44.421937, loop_end: Some(86.552000)),
        "safety_in_the_sanctuary": (file: "09_safety_in_the_sanctuary.ogg", loop_start: 21.696375, loop_end: Some(45.292000)),
        "hyrule_field_main_theme": (file: "10_hyrule_field_main_theme.ogg", loop_start: 11.529250, loop_end: Some(46.638000)),
        "kakariko_village": (file: "11_kakariko_village.ogg", loop_start: 49.240000, loop_end: Some(138.768000)),
        "guessing_game_house": (file: "12_guessing_game_house.ogg", loop_start: 13.270000, loop_end: Some(33.434000)),
        "fortune_teller": (file: "13_fortune_teller.ogg", loop_start: 2.202000, loop_end: Some(21.228000)),
        "soldiers_of_kakariko_village": (file: "14_soldiers_of_kakariko_village.ogg", loop_start: 4.4973, loop_end: Some(12.992)),
        "dank_dungeons": (file: "15_dank_dungeons.ogg", loop_start: 18.020250, loop_end: Some(33.748000)),
        "lost_ancient_ruins": (file: "16_lost_ancient_ruins.ogg", loop_start: 69.577438, loop_end: Some(110.256000)),
        "anger_of_the_guardians": (file: "17_anger_of_the_guardians.ogg", loop_start: 7.550000, loop_end: Some(18.178000)),
        "great_victory": (file: "18_great_victory.ogg", once: true),
        "the_silly_pink_rabbit": (file: "19_the_silly_pink_rabbit.ogg", loop_start: 5.860000, loop_end: Some(30.836000)),
        "the_silly_pink_rabbit_storm": (file: "20_the_silly_pink_rabbit_storm.ogg", loop_start: 20.9924, loop_end: Some(45.968)),
        "forest_of_mystery": (file: "21_forest_of_mystery.ogg", loop_start: 3.500125, loop_end: Some(23.840000)),
        "unsealing_the_master_sword": (file: "22_unsealing_the_master_sword.ogg", once: true),
        "priest_of_the_dark_order": (file: "23_priest_of_the_dark_order.ogg", loop_start: 15.817125, loop_end: Some(44.900000)),
        "dark_golden_land": (file: "24_dark_golden_land.ogg", loop_start: 56.460000, loop_end: Some(116.144000)),
        "black_mist": (file: "25_black_mist.ogg", loop_start: 23.160000, loop_end: Some(70.556000)),
        "black_mist_storm": (file: "26_black_mist_storm.ogg", loop_start: 43.4842, loop_end: Some(90.96)),
        "dungeon_of_shadows": (file: "27_dungeon_of_shadows.ogg", loop_start: 23.630000, loop_end: Some(67.698000)),
        "meeting_the_maidens": (file: "28_meeting_the_maidens.ogg", loop_start: 20.200250, loop_end: Some(48.288000)),
        "the_goddess_appears": (file: "29_the_goddess_appears.ogg", loop_start: 14.562000, loop_end: Some(38.392000)),
        "release_of_ganon": (file: "30_release_of_ganon.ogg", once: true),
        "ganon_s_message": (file: "31_ganon_s_message.ogg", loop_start: 29.178062, loop_end: Some(58.260000)),
        "the_prince_of_darkness": (file: "32_the_prince_of_darkness.ogg", loop_start: 7.980000, loop_end: Some(37.832000)),
        "power_of_the_gods": (file: "33_power_of_the_gods.ogg", loop_start: 31.977937, loop_end: Some(70.272000)),
        "epilogue_beautiful_hyrule": (file: "34_epilogue_beautiful_hyrule.ogg", loop_start: 113.2061, loop_end: Some(217.04)),
        "staff_roll": (file: "35_staff_roll.ogg", loop_start: 113.1873, loop_end: Some(230.096)),
        // galerie (piste fournie) : boucle de presque tout le morceau, l'intro de harpe (3,5 s) jouee une fois
        "great_fairys_fountain": (file: "40_great_fairys_fountain.ogg", loop_start: 3.561219, loop_end: Some(28.176000)),
        "fierce_rainstorm": (file: "01_fierce_rainstorm.ogg", loop_start: 0.500000, loop_end: Some(6.000000), volume: 0.85),
        "howling_wind": (file: "02_howling_wind.ogg", loop_start: 0.500000, loop_end: Some(10.000000)),
        "jingle_secret": (file: "04_secret.ogg", once: true),
        "jingle_chest_appears": (file: "05_chest_appears.ogg", once: true),
        "jingle_got_a_key": (file: "06_got_a_key.ogg", once: true),
        "jingle_heart_piece": (file: "07_heart_piece.ogg", once: true),
        "jingle_heart_container": (file: "08_heart_container.ogg", once: true),
        "jingle_treasure": (file: "09_treasure.ogg", once: true),
        "dimensional_shift": (file: "10_dimensional_shift.ogg", once: true),
        "praying": (file: "13_praying.ogg", once: true),
        "jingle_teleport": (file: "15_teleport.ogg", once: true),
    },
    // Limitation des effets : max_voices (instances simultanees), min_interval (s),
    // volume (0..1), pitch_jitter (variation aleatoire de hauteur, ratio).
    // Volumes revus a la baisse au J2 (retour : son trop agressif) ; le filtre old-school
    // et le compresseur des effets sont dans le moteur (reglage dans les options).
    sfx: {
        "fighter_sword_1":   (max_voices: 3, min_interval: 0.05, volume: 0.42, pitch_jitter: 0.06),
        "fighter_sword_2":   (max_voices: 3, min_interval: 0.05, volume: 0.42, pitch_jitter: 0.06),
        "master_sword":      (max_voices: 2, min_interval: 0.08, volume: 0.4, pitch_jitter: 0.04),
        "sword_beam":        (max_voices: 2, min_interval: 0.08, volume: 0.32, pitch_jitter: 0.05),
        "small_enemy_hit":   (max_voices: 5, min_interval: 0.03, volume: 0.34, pitch_jitter: 0.12),
        "enemy_hit":         (max_voices: 3, min_interval: 0.05, volume: 0.34, pitch_jitter: 0.1),
        "enemy_dies":        (max_voices: 4, min_interval: 0.04, volume: 0.32, pitch_jitter: 0.1),
        "rupee":             (max_voices: 5, min_interval: 0.035, volume: 0.32, pitch_jitter: 0.0),
        "heart":             (max_voices: 2, min_interval: 0.05, volume: 0.5, pitch_jitter: 0.0),
        "pegasus_boots":     (max_voices: 2, min_interval: 0.05, volume: 0.5, pitch_jitter: 0.05),
        "link_hurt":         (max_voices: 1, min_interval: 0.1, volume: 0.62, pitch_jitter: 0.0),
        "link_dies":         (max_voices: 1, min_interval: 0.5, volume: 0.75, pitch_jitter: 0.0),
        "low_hp":            (max_voices: 1, min_interval: 0.2, volume: 0.26, pitch_jitter: 0.0),
        "item_get_1":        (max_voices: 1, min_interval: 0.3, volume: 0.55, pitch_jitter: 0.0),
        "item_get_2":        (max_voices: 1, min_interval: 0.3, volume: 0.55, pitch_jitter: 0.0),
        "spin_attack":       (max_voices: 2, min_interval: 0.1, volume: 0.42, pitch_jitter: 0.0),
        "sword_shine_1":     (max_voices: 1, min_interval: 0.1, volume: 0.4, pitch_jitter: 0.0),
        "cursor":            (max_voices: 2, min_interval: 0.03, volume: 0.45, pitch_jitter: 0.0),
        "menu_open":         (max_voices: 1, min_interval: 0.1, volume: 0.45, pitch_jitter: 0.0),
        "menu_close":        (max_voices: 1, min_interval: 0.1, volume: 0.45, pitch_jitter: 0.0),
        "message_finish":    (max_voices: 1, min_interval: 0.06, volume: 0.42, pitch_jitter: 0.0),
        // lettres des dialogues (fee) : discret, pas plus de 20 par seconde
        "message":           (max_voices: 1, min_interval: 0.05, volume: 0.2, pitch_jitter: 0.0),
        "arrow_1":           (max_voices: 3, min_interval: 0.06, volume: 0.32, pitch_jitter: 0.08),
        "arrow_2":           (max_voices: 3, min_interval: 0.06, volume: 0.32, pitch_jitter: 0.08),
        "boomerang":         (max_voices: 2, min_interval: 0.12, volume: 0.3, pitch_jitter: 0.06),
        "fire_rod":          (max_voices: 2, min_interval: 0.1, volume: 0.34, pitch_jitter: 0.05),
        "fire":              (max_voices: 2, min_interval: 0.15, volume: 0.3, pitch_jitter: 0.08),
        "ice_rod":           (max_voices: 2, min_interval: 0.1, volume: 0.34, pitch_jitter: 0.05),
        "hammer_pound":      (max_voices: 2, min_interval: 0.1, volume: 0.5, pitch_jitter: 0.04),
        "lay_bomb":          (max_voices: 2, min_interval: 0.1, volume: 0.3, pitch_jitter: 0.05),
        "bomb_explode":      (max_voices: 3, min_interval: 0.06, volume: 0.42, pitch_jitter: 0.08),
        "cane":              (max_voices: 1, min_interval: 0.2, volume: 0.32, pitch_jitter: 0.0),
        // tornades de l'ocarina : une seule flute a la fois (avant : volume 1 par defaut, jusqu'a 4 voix)
        "flute_soft":        (max_voices: 1, min_interval: 1.0, volume: 0.5, pitch_jitter: 0.0),
        "fairy":             (max_voices: 1, min_interval: 0.2, volume: 0.32, pitch_jitter: 0.0),
        "quake_1":           (max_voices: 1, min_interval: 0.3, volume: 0.55, pitch_jitter: 0.0),
        "thunder":           (max_voices: 1, min_interval: 0.3, volume: 0.5, pitch_jitter: 0.0),
        "shock":             (max_voices: 2, min_interval: 0.1, volume: 0.3, pitch_jitter: 0.05),
        "throw":             (max_voices: 3, min_interval: 0.08, volume: 0.3, pitch_jitter: 0.08),
        "soldier":           (max_voices: 2, min_interval: 0.25, volume: 0.28, pitch_jitter: 0.05),
        "chest_appears_1":   (max_voices: 1, min_interval: 0.3, volume: 0.5, pitch_jitter: 0.0),
        "chest_open":        (max_voices: 1, min_interval: 0.3, volume: 0.55, pitch_jitter: 0.0),
        "item_get_3":        (max_voices: 1, min_interval: 0.3, volume: 0.6, pitch_jitter: 0.0),
        "boss_hit":          (max_voices: 2, min_interval: 0.08, volume: 0.4, pitch_jitter: 0.05),
        "boss_dies":         (max_voices: 1, min_interval: 0.5, volume: 0.7, pitch_jitter: 0.0),
        "large_beam":        (max_voices: 1, min_interval: 0.3, volume: 0.45, pitch_jitter: 0.0),
        "secret":            (max_voices: 1, min_interval: 0.5, volume: 0.5, pitch_jitter: 0.0),
        "tink":              (max_voices: 2, min_interval: 0.05, volume: 0.32, pitch_jitter: 0.06),
        "crystal":           (max_voices: 1, min_interval: 0.2, volume: 0.42, pitch_jitter: 0.0),
        // fin du jingle Unsealing the Master Sword (piste 22), coupee par research : joue a la fusion
        "master_sword_fusion": (max_voices: 1, min_interval: 1.0, volume: 0.6, pitch_jitter: 0.0),
        "spin_energy":       (max_voices: 1, min_interval: 0.4, volume: 0.4, pitch_jitter: 0.0),
        // 0.4 : nouvelles armes, decor cassable, Bob-omb, objets rares
        "hookshot":          (max_voices: 2, min_interval: 0.12, volume: 0.3, pitch_jitter: 0.05),
        "bee":               (max_voices: 1, min_interval: 0.4, volume: 0.22, pitch_jitter: 0.08),
        "fireball":          (max_voices: 2, min_interval: 0.1, volume: 0.3, pitch_jitter: 0.06),
        "grass_destroyed":   (max_voices: 3, min_interval: 0.05, volume: 0.34, pitch_jitter: 0.1),
        "break":             (max_voices: 3, min_interval: 0.05, volume: 0.34, pitch_jitter: 0.1),
        "bombable_wall":     (max_voices: 1, min_interval: 0.5, volume: 0.6, pitch_jitter: 0.0),
        "quake_2":           (max_voices: 1, min_interval: 0.3, volume: 0.55, pitch_jitter: 0.0),
        "bug_net":           (max_voices: 1, min_interval: 0.2, volume: 0.45, pitch_jitter: 0.0),
        "life_refill":       (max_voices: 1, min_interval: 0.3, volume: 0.45, pitch_jitter: 0.0),
        "item_get_4":        (max_voices: 1, min_interval: 0.3, volume: 0.55, pitch_jitter: 0.0),
        "magic_powder_2":    (max_voices: 1, min_interval: 0.3, volume: 0.4, pitch_jitter: 0.0),
        // 0.6 : sons propres a certains ennemis, fanfare des coffres, Pikit
        "agahnim_shoot":     (max_voices: 2, min_interval: 0.15, volume: 0.36, pitch_jitter: 0.03),
        "agahnim_charge":    (max_voices: 1, min_interval: 0.4, volume: 0.36, pitch_jitter: 0.0),
        "heart_piece_1":     (max_voices: 1, min_interval: 0.3, volume: 0.5, pitch_jitter: 0.0),
        "sword_shine_2":     (max_voices: 1, min_interval: 0.2, volume: 0.42, pitch_jitter: 0.0),
        "wallet_1":          (max_voices: 1, min_interval: 0.3, volume: 0.45, pitch_jitter: 0.0),
        "zol":               (max_voices: 2, min_interval: 0.2, volume: 0.28, pitch_jitter: 0.08),
        // 0.6.1 : arpege montant joyeux pour les choix importants
        "heart_container_1": (max_voices: 1, min_interval: 0.3, volume: 0.5, pitch_jitter: 0.0),
    },
    // Evenement du jeu -> effets (un tirage au hasard si plusieurs).
    events: {
        "swing":         ["fighter_sword_1", "fighter_sword_2"],
        "swing_master":  ["master_sword"],
        "enemy_hit":     ["small_enemy_hit"],
        "enemy_crit":    ["enemy_hit"],
        "enemy_die":     ["enemy_dies"],
        "rupee":         ["rupee"],
        "heart":         ["heart"],
        "dash":          ["pegasus_boots"],
        "hurt":          ["link_hurt"],
        "die":           ["link_dies"],
        "low_hp":        ["low_hp"],
        "level_up":      ["item_get_1"],
        "level_wave":    ["spin_attack"],
        "toggle_auto":   ["sword_shine_1"],
        "pause":         ["menu_open"],
        "unpause":       ["menu_close"],
        "cursor":        ["cursor"],
        // choix d'amelioration en partie : aucun son pour un choix ordinaire ; arpege joyeux pour un
        // choix important (fusion, niveau maximal, recompense de rencontre) ; menus : tintement court
        "pick":          ["item_get_2"],
        "reroll":        ["menu_open"],
        "skip":          ["menu_close"],
        "pick_big":      ["heart_container_1"],
        "confirm":       ["message_finish"],
        "error":         ["error"],
        // 0.6.3 : PNJ de passage (diseuse, sorciere) et potions
        "npc_arrive":    ["magic_powder_2"],
        "npc_leave":     ["magic_powder_1"],
        "potion_drink":  ["magic_meter_1"],
        "fortune_win":   ["item_get_3"],
        "explosion":     ["bomb_explode"],
        "frozen":        ["tink"],
        "windup":        ["soldier"],
        "enemy_shot":    ["throw"],
        "shot_blast":    ["bomb_explode"],
        "elite":         ["crystal"],
        "boss_spawn":    ["large_beam"],
        "boss_hit":      ["boss_hit"],
        "boss_die":      ["boss_dies"],
        "chest_drop":    ["chest_appears_1"],
        // coffre : craquement du couvercle puis la fanfare connue de tous (La, La#, Si, Do)
        "chest_open":    ["chest_open"],
        "chest_fanfare": ["item_get_4"],
        // evolution : eclat de l'Epee de legende par-dessus la fanfare
        "evolution":     ["sword_shine_2"],
        "mass_kill":     ["spin_energy"],
        // sons des armes (cle `sfx` de weapons.ron)
        "bow":           ["arrow_1", "arrow_2"],
        "boomerang":     ["boomerang"],
        "fire_rod":      ["fire_rod"],
        "ice_rod":       ["ice_rod"],
        "hammer":        ["hammer_pound"],
        "bomb":          ["lay_bomb"],
        "byrna":         ["cane"],
        "fairy":         ["fairy"],
        "bombos":        ["fire"],
        "ether":         ["thunder"],
        "storm_thunder": ["thunder"],
        "quake":         ["quake_1"],
        "beam":          ["sword_beam"],
        // stages : bonds et teleportations des boss, porte de sortie, victoire
        "boss_slam":     ["quake_2"],
        "teleport":      ["teleport"],
        "portal_open":   ["secret"],
        "buy":           ["item_get_2"],
        "equip":         ["button"],
        "relic":         ["heart_piece_1"],
        "save_code":     ["message_finish"],
        "text":          ["message"],
        "dialog_open":   ["menu_open"],
        "dialog_close":  ["menu_close"],
        "victory":       ["warp"],
        // 0.4
        "hookshot":      ["hookshot"],
        "somaria":       ["cane"],
        "somaria_burst": ["fireball"],
        "bees":          ["bee"],
        "bush_break":    ["grass_destroyed"],
        "pot_break":     ["break"],
        "bomb_spawn":    ["lay_bomb"],
        "screen_clear":  ["bombable_wall"],
        "screen_rumble": ["quake_2"],
        "net_pickup":    ["bug_net"],
        "fairy_pickup":  ["life_refill"],
        "medallion":     ["thunder"],
        "char_unlock":   ["secret"],
        "weapon_unlock": ["item_get_3"],
        "evo_merge":     ["master_sword_fusion"],
        "powder":        ["magic_powder_2"],
        // 0.6.2 : nouvelles armes
        "slingshot":     ["throw"],
        "roc_feather":   ["flap"],
        "land":          ["land"],
        "lantern":       ["fire"],
        "gust_jar":      ["whirpool"],
        // 0.9.1 : flute adoucie (aigus coupes, fondus : research/tools/soft_flute.sh), a mi-volume
        "ocarina":       ["flute_soft"],
        "din_fire":      ["fire"],
        // 0.5
        "encounter":     ["secret"],
        // une fusion est proposee au choix de niveau (jingle des secrets d'A Link to the Past)
        "fusion_offer":  ["secret"],
        "encounter_won": ["item_get_3"],
        "encounter_fled": ["menu_close"],
        "reward":        ["item_get_2"],
        // 0.6 : tirs et annonces propres a un ennemi (cle « shot.<ennemi> » / « windup.<ennemi> »,
        // sinon « enemy_shot » / « windup »)
        "shot.agahnim":    ["agahnim_shoot"],
        "windup.agahnim":  ["agahnim_charge"],
        "shot.archer":     ["arrow_1", "arrow_2"],
        "shot.lynel":      ["fireball"],
        "shot.ganon":      ["fireball"],
        "shot.kholdstare": ["ice_rod"],
        // voleur de rubis (Boo) : arrivee, rubis rendus
        "thief_spawn":   ["wallet_1"],
        "thief_loot":    ["secret"],
    },
)
