// Progression entre les parties.
// Rubis en banque : a la fin d'une partie, rubis ramasses / 4, x1.5 en cas de victoire,
// x difficulte, x (1 + bonus des Sceaux), x (1 + Avarice).
// Couts de la boutique : cost x growth^niveau (arrondi a 10).
(
    // difficultes : du plus facile au plus dur (la 2e est le reglage par defaut)
    difficulties: [
        (id: "easy",   enemy_hp: 0.7, enemy_damage: 0.6, spawn_rate: 0.8,  rupees: 0.75),
        (id: "normal", enemy_hp: 1.0, enemy_damage: 1.0, spawn_rate: 1.0,  rupees: 1.0),
        (id: "hard",   enemy_hp: 1.4, enemy_damage: 1.4, spawn_rate: 1.2,  rupees: 1.35),
        (id: "hero",   enemy_hp: 2.0, enemy_damage: 2.0, spawn_rate: 1.4,  rupees: 1.8),
    ],
    // Boutique de Kakariko : bonus permanents par niveau
    shop: [
        (id: "heart",    icon: "icon_heart_container", stat: Some(MaxHp),        per_level: 10.0,  max: 5, cost: 150, growth: 1.6),
        (id: "might",    icon: "icon_red_potion",      stat: Some(Might),        per_level: 0.05,  max: 5, cost: 200, growth: 1.6),
        (id: "armor",    icon: "icon_blue_mail",       stat: Some(Armor),        per_level: 1.0,   max: 3, cost: 300, growth: 1.8),
        (id: "speed",    icon: "icon_boots",           stat: Some(MoveSpeed),    per_level: 0.04,  max: 3, cost: 200, growth: 1.6),
        (id: "cooldown", icon: "icon_half_magic",      stat: Some(Cooldown),     per_level: -0.03, max: 3, cost: 300, growth: 1.7),
        (id: "area",     icon: "icon_green_potion",    stat: Some(Area),         per_level: 0.05,  max: 3, cost: 250, growth: 1.6),
        (id: "magnet",   icon: "icon_bug_net",         stat: Some(Magnet),       per_level: 0.15,  max: 3, cost: 120, growth: 1.5),
        (id: "regen",    icon: "icon_heart",           stat: Some(Regen),        per_level: 0.1,   max: 3, cost: 300, growth: 1.8),
        (id: "luck",     icon: "icon_mushroom",        stat: Some(Luck),         per_level: 0.05,  max: 3, cost: 250, growth: 1.7),
        (id: "growth",   icon: "icon_book",            stat: Some(Growth),       per_level: 0.04,  max: 3, cost: 300, growth: 1.8),
        (id: "greed",    icon: "icon_rupees",          stat: None,               per_level: 0.1,   max: 5, cost: 250, growth: 1.7),
        // 0.6.2 : relances et passes en plus a la montee de niveau
        (id: "reroll",   icon: "icon_lens_of_truth",   stat: None, perk: Some(Reroll), per_level: 1.0, max: 3, cost: 400, growth: 2.0),
        (id: "skip",     icon: "icon_kinstone",        stat: None, perk: Some(Skip),   per_level: 1.0, max: 3, cost: 300, growth: 2.0),
    ],
    // Grande Fee : benedictions achetees une fois
    blessings: [
        // 0.6.3 : la sorciere (poudre magique) passe dans chaque partie et vend ses potions ; en tete (0.6.4)
        (id: "witch",   icon: "icon_magic_powder", cost: 10000, effect: Witch),
        (id: "fairy",   icon: "icon_fairy_bottle", cost: 800,  effect: Revive),
        (id: "fairy2",  icon: "icon_fairy_bottle", cost: 2500, effect: Revive, requires: Some("fairy")),
        (id: "wisdom",  icon: "icon_blue_potion",  cost: 1200, effect: Xp(0.15)),
        (id: "healing", icon: "icon_heart",        cost: 900,  effect: Heal(0.5)),
    ],
    // Reliques : la premiere victoire d'un stage donne la sienne ; `max_relics` equipees a la fois.
    // `encounter: true` : relique proposee par les champions errants (rencontres), gardee si la partie est gagnee.
    max_relics: 3,
    relics: [
        // 0.7.1 : reliques a acheter dans la boutique (`cost`) : cinq bon marche en tete (par prix), puis le Flacon ;
        // environ 20 % des reliques, les autres se trouvent toujours dans les stages et les rencontres
        (id: "apple",          icon: "icon_apple",          cost: 250, stats: [(MaxHp, 10.0)]),
        (id: "fighter_shield", icon: "icon_fighter_shield", cost: 300, stats: [(Armor, 1.0)]),
        (id: "magic_jar",      icon: "icon_magic_jar",      cost: 400, stats: [(Cooldown, -0.03)]),
        // icones deja vues ailleurs (boutique de Cocorico, garde-robe) : pas d'autre objet dans les planches
        (id: "rupee_pouch",    icon: "icon_rupees",         cost: 500, stats: [(Magnet, 0.15)]),
        (id: "green_tunic",    icon: "icon_green_mail",     cost: 600, stats: [(Growth, 0.05)]),
        (id: "bottle",         icon: "icon_bottle",         cost: 1500, stats: [(Regen, 0.2)]),
        (id: "pendant_courage", icon: "icon_pendant_courage", stage: "hyrule_field", stats: [(Might, 0.1)]),
        (id: "pendant_power",   icon: "icon_pendant_power",   stage: "lost_woods",   stats: [(MaxHp, 20.0)]),
        (id: "pendant_wisdom",  icon: "icon_pendant_wisdom",  stage: "desert",       stats: [(Cooldown, -0.08)]),
        (id: "moon_pearl",      icon: "icon_pearl",           stage: "ice_lake",     stats: [(MoveSpeed, 0.08), (Armor, 1.0)]),
        (id: "crystal",         icon: "icon_crystal",         stage: "pyramid",      stats: [(Amount, 1.0)]),
        (id: "magic_mirror",    icon: "icon_magic_mirror",    stage: "death_mountain", stats: [(Area, 0.08), (Duration, 0.1)]),
        // reliques des rencontres
        (id: "big_key",      icon: "icon_big_key",      encounter: true, stats: [(Luck, 0.15)]),
        (id: "titan_mitt",   icon: "icon_titan_mitt",   encounter: true, stats: [(Might, 0.06), (Armor, 1.0)]),
        (id: "red_mail",     icon: "icon_red_mail",     encounter: true, stats: [(Armor, 2.0), (MoveSpeed, -0.04)]),
        (id: "shovel",       icon: "icon_shovel",       encounter: true, stats: [(Magnet, 0.3), (Growth, 0.06)]),
        (id: "small_key",    icon: "icon_small_key",    encounter: true, stats: [(DashCooldown, -0.15), (MoveSpeed, 0.04)]),
        (id: "golden_sword", icon: "icon_golden_sword", encounter: true, stats: [(Might, 0.12), (Cooldown, 0.05)]),
        (id: "fire_shield",  icon: "icon_fire_shield",  encounter: true, stats: [(MaxHp, 20.0), (Speed, 0.1)]),
        // 0.6.2 : une relance / une passe de plus pour toute la partie (choix de la montee de niveau)
        (id: "lens_of_truth", icon: "icon_lens_of_truth", encounter: true, stats: [], rerolls: 1),
        (id: "kinstone",      icon: "icon_kinstone",      encounter: true, stats: [], skips: 1),
    ],
    // 0.6.3 : de quoi depenser les rubis une fois tout debloque, sans rendre les personnages plus forts.
    // Garde-robe : tenues achetees une fois (couleurs du personnage, voir `skins`).
    wardrobe: [
        (character: "link", sprite: "link_blue", icon: "icon_blue_mail", cost: 3000),
        (character: "link", sprite: "link_red",  icon: "icon_red_mail",  cost: 6000),
        // 0.6.4 : sans icone, la ligne montre la tenue elle-meme (recolorations : gen_wardrobe_v064.py)
        (character: "link",       sprite: "link_bunny",       cost: 4000),
        (character: "link_adult", sprite: "link_adult_goron", cost: 3000),
        (character: "link_adult", sprite: "link_adult_zora",  cost: 3000),
        (character: "toon_link",  sprite: "toon_link_red",    cost: 2500),
        (character: "toon_link",  sprite: "toon_link_blue",   cost: 2500),
    ],
    // Juke-box : musiques a acheter, puis a choisir pour l'ecran titre (la premiere est offerte).
    jukebox: [
        (id: "seal_of_seven_maidens", cost: 0),
        (id: "title_link_to_the_past", cost: 300),
        (id: "beginning_of_the_journey", cost: 300),
        (id: "time_of_the_falling_rain", cost: 300),
        (id: "majestic_castle", cost: 400),
        (id: "princess_zelda_s_rescue", cost: 400),
        (id: "safety_in_the_sanctuary", cost: 400),
        (id: "hyrule_field_main_theme", cost: 500),
        (id: "kakariko_village", cost: 500),
        (id: "guessing_game_house", cost: 500),
        (id: "fortune_teller", cost: 500),
        (id: "soldiers_of_kakariko_village", cost: 500),
        (id: "dank_dungeons", cost: 600),
        (id: "lost_ancient_ruins", cost: 600),
        (id: "forest_of_mystery", cost: 600),
        (id: "anger_of_the_guardians", cost: 800),
        (id: "the_silly_pink_rabbit", cost: 800),
        (id: "priest_of_the_dark_order", cost: 800),
        (id: "dark_golden_land", cost: 1000),
        (id: "black_mist", cost: 1000),
        (id: "dungeon_of_shadows", cost: 1000),
        (id: "meeting_the_maidens", cost: 1000),
        (id: "the_goddess_appears", cost: 1200),
        (id: "ganon_s_message", cost: 1500),
        (id: "the_prince_of_darkness", cost: 1500),
        (id: "power_of_the_gods", cost: 2000),
        (id: "epilogue_beautiful_hyrule", cost: 3000),
        (id: "staff_roll", cost: 3000),
    ],
    // Offrandes a la Grande Fee : titre au classement en ligne (pseudo en couleur), dans l'ordre.
    titles: [
        (id: "fairy_friend", cost: 5000),
        (id: "knight",       cost: 20000),
        (id: "hero",         cost: 60000),
    ],
    // Figurines du bestiaire : ennemi, boss, Ganon
    figurines: (150, 1000, 5000),
    // 0.7.1 : prix de chaque autre couleur d'un personnage (garde-robe) ; la premiere est offerte
    skin_cost: 500,
    // Sceaux de Ganon : defis optionnels, chacun augmente les rubis mis en banque
    seals: [
        (id: "seal_might",  icon: "icon_sage_spirit",     enemy_hp: 1.5,     bonus: 0.25),
        (id: "seal_swarm",  icon: "icon_sage_forest",     spawn_rate: 1.35,  bonus: 0.25),
        (id: "seal_fury",   icon: "icon_sage_fire",       enemy_damage: 1.5, bonus: 0.25),
        (id: "seal_haste",  icon: "icon_sage_water",      enemy_speed: 1.2,  bonus: 0.2),
        (id: "seal_famine", icon: "icon_sage_shadow",     heal: 0.0,         bonus: 0.3),
    ],
)
