// Regles globales de progression et d'equilibrage. 1 coeur = 10 points de vie.
(
    // experience (rubis) pour passer du niveau 1 au 2, puis increment par niveau
    xp_first: 5.0,
    xp_step: 8.0,
    xp_step_late: 4.0,
    // onde de choc de montee de niveau : repousse sans blesser (J2)
    levelup_wave_radius: 110.0,
    levelup_wave_force: 420.0,
    hurt_iframes: 0.8,
    heart_drop: 0.01,
    heart_heal: 10.0,
    max_pickups: 1500,
    // vie des ennemis : +12 % par minute de partie
    hp_growth: 0.12,
    // elites : vie x12, degats x1.5, un gros rubis + un coffre
    elite_hp: 12.0,
    elite_damage: 1.5,
    elite_xp: 20,
    // emplacements : 6 armes, 6 objets passifs (on ne peut pas tout avoir : les choix comptent)
    max_weapons: 6,
    max_passives: 6,
    choices: 3,
    // coffre sans evolution possible : 1 a 3 ameliorations (1 le plus souvent)
    chest_upgrades: (1, 3),
    // quand tout est au maximum
    fallback_heal: 20.0,
    fallback_rupees: 25,
    // Bob-omb : une toutes les 60 a 100 s (pas deux a la fois) ; vaincue, elle vide l'ecran
    bomb_enemy: "bobomb",
    bomb_every: (170.0, 240.0),
    // decor cassable : butin (objet, poids) ; la Chance rend le « rien » plus rare
    prop_drops: [
        (Nothing, 58.0),
        (RupeeGreen, 24.0),
        (RupeeBlue, 6.0),
        (RupeeRed, 1.5),
        (Heart, 6.0),
        (Magnet, 1.2),
        (Fairy, 0.8),
        (Medallion, 1.0),
    ],
    // Chance : +10 % de chance = +3 points de critique
    luck_crit: 0.3,
    // 0.6 : tirs ennemis un peu plus lents (lisibles), et zone de contact 10 % plus petite que le sprite
    shot_speed: 0.78,
    shot_hitbox: 0.9,
    // 0.6 : Pikit voleur de rubis, 2 a 3 fois par partie ; vaincu, tous les rubis au sol viennent au joueur.
    // Il repart au bout de `life` secondes ; pas pendant un boss (il attend la fin).
    thief: (enemy: "pikit", first: 110.0, every: (150.0, 190.0), life: 45.0, hp: 1.0, flee: 130.0),
)
