// Regles globales de progression et d'equilibrage. 1 coeur = 10 points de vie.
(
    // experience (rubis) pour passer du niveau 1 au 2, puis increment par niveau
    xp_first: 5.0,
    xp_step: 8.0,
    xp_step_late: 4.0,
    // onde de choc de montee de niveau : repousse sans blesser (J2)
    levelup_wave_radius: 110.0,
    levelup_wave_force: 420.0,
    hurt_iframes: 0.8,
    heart_drop: 0.01,
    heart_heal: 10.0,
    max_pickups: 1500,
    // vie des ennemis : +12 % par minute de partie
    hp_growth: 0.12,
    // elites : vie x12, degats x1.5, un gros rubis + un coffre
    elite_hp: 12.0,
    elite_damage: 1.5,
    elite_xp: 20,
    // emplacements : 6 armes, 6 objets passifs (on ne peut pas tout avoir : les choix comptent)
    max_weapons: 6,
    max_passives: 6,
    choices: 3,
    // coffre sans evolution possible : 1 a 3 ameliorations (1 le plus souvent)
    chest_upgrades: (1, 3),
    // quand tout est au maximum
    fallback_heal: 20.0,
    fallback_rupees: 25,
)
