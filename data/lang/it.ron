    "weapon.sword.name": "Spada del guerriero",
    "weapon.sword.desc": "Colpisce i nemici vicini, pochi alla volta.",
    "weapon.master_sword.name": "Spada Suprema",
    "weapon.master_sword.desc": "Fusione suprema: la lama che scaccia il male. Raggi potenti e colpi critici.",
    "weapon.bow.name": "Arco",
    "weapon.bow.desc": "Scocca frecce verso i nemici più vicini.",
    "weapon.silver_bow.name": "Frecce d'argento",
    "weapon.silver_bow.desc": "Frecce che trafiggono tutto.",
    "weapon.boomerang.name": "Boomerang",
    "weapon.boomerang.desc": "Va e torna. Stordisce chi colpisce.",
    "weapon.magic_boomerang.name": "Boomerang magico",
    "weapon.magic_boomerang.desc": "Più veloce, più ampio, stordisce di più.",
    "weapon.fire_rod.name": "Verga di fuoco",
    "weapon.fire_rod.desc": "Palle di fuoco che incendiano il suolo.",
    "weapon.bombos.name": "Medaglione Bombos",
    "weapon.bombos.desc": "Colonne di fuoco piovono sullo schermo.",
    "weapon.ice_rod.name": "Verga di ghiaccio",
    "weapon.ice_rod.desc": "Schegge di ghiaccio che congelano.",
    "weapon.ether.name": "Medaglione Etere",
    "weapon.ether.desc": "Colpisce e congela tutto ciò che vedi.",
    "weapon.hammer.name": "Martello magico",
    "weapon.hammer.desc": "Percuote il suolo intorno a te. Stordisce.",
    "weapon.quake.name": "Medaglione Sisma",
    "weapon.quake.desc": "La terra stessa schiaccia i nemici.",
    "weapon.bombs.name": "Bombe",
    "weapon.bombs.desc": "Lanciate sui nemici. Grande esplosione.",
    "weapon.super_bomb.name": "Superbomba",
    "weapon.super_bomb.desc": "Esplosioni enormi, più di una alla volta.",
    "weapon.byrna.name": "Bastone di Byrna",
    "weapon.byrna.desc": "Scintille ti girano intorno per un po'.",
    "weapon.fairy_ring.name": "Girotondo di fate",
    "weapon.fairy_ring.desc": "Le fate danzano intorno a te senza andarsene.",
    "passive.pegasus_boots.name": "Stivali di Pegaso",
    "passive.pegasus_boots.desc": "Corri più veloce, scatta più spesso.",
    "passive.heart_container.name": "Portacuore",
    "passive.heart_container.desc": "Un cuore in più.",
    "passive.power_glove.name": "Guanto del potere",
    "passive.power_glove.desc": "Tutti i danni +10%.",
    "passive.mirror_shield.name": "Scudo specchio",
    "passive.mirror_shield.desc": "1 danno in meno per colpo.",
    "passive.quiver.name": "Faretra",
    "passive.quiver.desc": "Un proiettile in più per ogni arma.",
    "passive.half_magic.name": "Mezza magia",
    "passive.half_magic.desc": "Le armi si ricaricano l'8% più in fretta.",
    "passive.lamp.name": "Lanterna",
    "passive.lamp.desc": "Attacchi più grandi del 10%.",
    "passive.bug_net.name": "Retino",
    "passive.bug_net.desc": "Le rupie arrivano da più lontano.",
    "enemy.hinox": "Hinox",
    // 0.7.1 : conseils de la fee, deblocages sur plusieurs pages
    "fairy.tip.1": "Ehi, tu! Sì, proprio tu! Sono una fata della fonte. Già due sconfitte? Non arrenderti: anche gli eroi leggendari a volte cadono!",
    "fairy.tip.2": "Ascolta bene: le rupie che raccogli non vanno mai perse. Alla fine di ogni partita, una parte finisce nella tua *banca di rupie rosse*.",
    "fairy.tip.3": "Spendile nel *Negozio*, dal menu principale! A *Calbarico* potenzi per sempre i tuoi cuori, la tua forza, la tua armatura...",
    "fairy.tip.4": "La *Grande Fata* ti concede le sue benedizioni, e troverai anche reliquie, sfide, eroi da reclutare e tanti altri tesori!",
    "fairy.tip.5": "Ogni acquisto ti rende più forte, e più sei forte, più lontano arriverai. Coraggio! Veglierò su di te.",
    "fairy.skip_ask": "Ehi! Vuoi davvero che stia zitta?",
    "fairy.skip_no": "No, continua",
    "fairy.skip_yes": "Sì, salta i consigli",
    "fairy.hint": "Conferma: avanti - Indietro: salta",
    "ui.unlocks_more": "Avanti (altri {n})",
}
