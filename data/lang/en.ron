    "char.co_gustave.name": "Gustave",
    "char.co_gustave.desc": "Expedition 33's engineer with a mechanical arm. More damage and shorter cooldowns, a bit slow. Starts with the sword.",
    "char.co_maelle.name": "Maelle",
    "char.co_maelle.desc": "Expedition 33's fencer. Fast and lucky, but fragile. Starts with the hookshot, lunging like a rapier.",
    "char.co_lune.name": "Lune",
    "char.co_lune.desc": "Expedition 33's elemental mage. Bigger, more frequent spells, a bit slow. Starts with the fire rod.",
    "char.co_sciel.name": "Sciel",
    "char.co_sciel.desc": "Expedition 33's card reader. Very lucky, longer effects. Starts with the boomerang: her blades come back.",
    "char.co_monoco.name": "Monoco",
    "char.co_monoco.desc": "Expedition 33's playful Gestral. Hits hard and takes hits, but slow. Starts with the hammer.",
    "char.co_verso.name": "Verso",
    "char.co_verso.desc": "Expedition 33's mysterious swordsman. Heavy damage and some luck, slower dash. Starts with the sword.",
    "char.co_esquie.name": "Esquie",
    "char.co_esquie.desc": "Expedition 33's big-hearted giant. Very sturdy, wide area, slow. Starts with the magic powder: a cloud around him.",
