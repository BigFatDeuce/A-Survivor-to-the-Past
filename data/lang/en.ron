    "weapon.sword.name": "Fighter's Sword",
    "weapon.sword.desc": "Slashes nearby foes. Hits a few at a time.",
    "weapon.master_sword.name": "Master Sword",
    "weapon.master_sword.desc": "Ultimate fusion: the blade of evil's bane. Mighty beams and critical hits.",
    "weapon.bow.name": "Bow",
    "weapon.bow.desc": "Shoots arrows at the nearest foes.",
    "weapon.silver_bow.name": "Silver Arrows",
    "weapon.silver_bow.desc": "Piercing arrows that fear nothing.",
    "weapon.boomerang.name": "Boomerang",
    "weapon.boomerang.desc": "Flies out and back. Stuns what it hits.",
    "weapon.magic_boomerang.name": "Magical Boomerang",
    "weapon.magic_boomerang.desc": "Faster, wider, and stuns for longer.",
    "weapon.fire_rod.name": "Fire Rod",
    "weapon.fire_rod.desc": "Fireballs that leave the ground burning.",
    "weapon.bombos.name": "Bombos Medallion",
    "weapon.bombos.desc": "Pillars of fire rain on the screen.",
    "weapon.ice_rod.name": "Ice Rod",
    "weapon.ice_rod.desc": "Ice shards that freeze foes in place.",
    "weapon.ether.name": "Ether Medallion",
    "weapon.ether.desc": "Strikes and freezes everything in sight.",
    "weapon.hammer.name": "Magic Hammer",
    "weapon.hammer.desc": "Pounds the ground around you. Stuns.",
    "weapon.quake.name": "Quake Medallion",
    "weapon.quake.desc": "The earth itself crushes your foes.",
    "weapon.bombs.name": "Bombs",
    "weapon.bombs.desc": "Lobbed at foes. Big blast after a short fuse.",
    "weapon.super_bomb.name": "Super Bomb",
    "weapon.super_bomb.desc": "Huge explosions, several at once.",
    "weapon.byrna.name": "Cane of Byrna",
    "weapon.byrna.desc": "Sparks circle around you for a while.",
    "weapon.fairy_ring.name": "Fairy Ring",
    "weapon.fairy_ring.desc": "Fairies dance around you, never leaving.",
    "passive.pegasus_boots.name": "Pegasus Boots",
    "passive.pegasus_boots.desc": "Run faster, dash more often.",
    "passive.heart_container.name": "Heart Container",
    "passive.heart_container.desc": "One more heart.",
    "passive.power_glove.name": "Power Glove",
    "passive.power_glove.desc": "All damage +10%.",
    "passive.mirror_shield.name": "Mirror Shield",
    "passive.mirror_shield.desc": "Take 1 less damage per hit.",
    "passive.quiver.name": "Quiver",
    "passive.quiver.desc": "One more projectile for every weapon.",
    "passive.half_magic.name": "Half Magic",
    "passive.half_magic.desc": "Weapons recharge 8% faster.",
    "passive.lamp.name": "Lamp",
    "passive.lamp.desc": "Attacks are 10% larger.",
    "passive.bug_net.name": "Bug-Catching Net",
