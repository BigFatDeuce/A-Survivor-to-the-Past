    "char.co_gustave.name": "Gustave",
    "char.co_gustave.desc": "Engenheiro da Expedição 33 com braço mecânico. Mais dano e recarga menor, um pouco lento. Começa com a espada.",
    "char.co_maelle.name": "Maelle",
    "char.co_maelle.desc": "Esgrimista da Expedição 33. Rápida e sortuda, mas frágil. Começa com o gancho, em estocada de florete.",
    "char.co_lune.name": "Lune",
    "char.co_lune.desc": "Maga elemental da Expedição 33. Feitiços maiores e mais frequentes, um pouco lenta. Começa com a vara de fogo.",
    "char.co_sciel.name": "Sciel",
    "char.co_sciel.desc": "Cartomante da Expedição 33. Muito sortuda, efeitos mais longos. Começa com o bumerangue: suas lâminas voltam.",
    "char.co_monoco.name": "Monoco",
    "char.co_monoco.desc": "Gestral brincalhão da Expedição 33. Bate forte e aguenta, mas é lento. Começa com o martelo.",
    "char.co_verso.name": "Verso",
    "char.co_verso.desc": "Espadachim misterioso da Expedição 33. Muito dano e um pouco de sorte, esquiva mais lenta. Começa com a espada.",
    "char.co_esquie.name": "Esquie",
    "char.co_esquie.desc": "Gigante de bom coração da Expedição 33. Muito resistente, área grande, lento. Começa com o pó mágico: uma nuvem ao redor dele.",
