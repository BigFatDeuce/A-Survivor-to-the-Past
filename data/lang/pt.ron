    "weapon.sword.name": "Espada do guerreiro",
    "weapon.sword.desc": "Corta inimigos próximos, poucos de cada vez.",
    "weapon.master_sword.name": "Espada Mestra",
    "weapon.master_sword.desc": "Fusão suprema: a lâmina que bane o mal. Raios fortes e golpes críticos.",
    "weapon.bow.name": "Arco",
    "weapon.bow.desc": "Dispara flechas nos inimigos mais próximos.",
    "weapon.silver_bow.name": "Flechas de prata",
    "weapon.silver_bow.desc": "Flechas que atravessam tudo.",
    "weapon.boomerang.name": "Bumerangue",
    "weapon.boomerang.desc": "Vai e volta. Atordoa quem acerta.",
    "weapon.magic_boomerang.name": "Bumerangue mágico",
    "weapon.magic_boomerang.desc": "Mais rápido, mais largo, atordoa mais.",
    "weapon.fire_rod.name": "Bastão de fogo",
    "weapon.fire_rod.desc": "Bolas de fogo que incendeiam o chão.",
    "weapon.bombos.name": "Medalhão Bombos",
    "weapon.bombos.desc": "Colunas de fogo caem sobre a tela.",
    "weapon.ice_rod.name": "Bastão de gelo",
    "weapon.ice_rod.desc": "Estilhaços de gelo que congelam.",
    "weapon.ether.name": "Medalhão Éter",
    "weapon.ether.desc": "Atinge e congela tudo à vista.",
    "weapon.hammer.name": "Martelo mágico",
    "weapon.hammer.desc": "Golpeia o chão ao seu redor. Atordoa.",
    "weapon.quake.name": "Medalhão Tremor",
    "weapon.quake.desc": "A própria terra esmaga seus inimigos.",
    "weapon.bombs.name": "Bombas",
    "weapon.bombs.desc": "Lançadas nos inimigos. Grande explosão.",
    "weapon.super_bomb.name": "Superbomba",
    "weapon.super_bomb.desc": "Explosões enormes, várias de uma vez.",
    "weapon.byrna.name": "Cetro de Byrna",
    "weapon.byrna.desc": "Faíscas giram ao seu redor por um tempo.",
    "weapon.fairy_ring.name": "Roda de fadas",
    "weapon.fairy_ring.desc": "Fadas dançam ao seu redor sem partir.",
    "passive.pegasus_boots.name": "Botas de Pégaso",
    "passive.pegasus_boots.desc": "Corra mais rápido, invista mais vezes.",
    "passive.heart_container.name": "Recipiente de coração",
    "passive.heart_container.desc": "Um coração a mais.",
    "passive.power_glove.name": "Luva de poder",
    "passive.power_glove.desc": "Todo o dano +10%.",
    "passive.mirror_shield.name": "Escudo espelhado",
    "passive.mirror_shield.desc": "1 de dano a menos por golpe.",
    "passive.quiver.name": "Aljava",
    "passive.quiver.desc": "Um projétil a mais para cada arma.",
    "passive.half_magic.name": "Meia magia",
    "passive.half_magic.desc": "Armas recarregam 8% mais rápido.",
    "passive.lamp.name": "Lamparina",
    "passive.lamp.desc": "Ataques 10% maiores.",
    "passive.bug_net.name": "Rede de insetos",
    "passive.bug_net.desc": "Rupias vêm de mais longe.",
    "enemy.hinox": "Hinox",
    // 0.7.1 : conseils de la fee, deblocages sur plusieurs pages
    "fairy.tip.1": "Ei, você! Sim, você! Sou uma fada da fonte. Já duas derrotas? Não desista: até os heróis lendários caem às vezes!",
    "fairy.tip.2": "Escute bem: as rupias que você coleta nunca se perdem. No fim de cada partida, uma parte vai para o seu *banco de rupias vermelhas*.",
    "fairy.tip.3": "Gaste-as na *Loja*, no menu principal! Em *Kakariko*, fortaleça para sempre seus corações, sua força, sua armadura...",
    "fairy.tip.4": "A *Grande Fada* concede suas bênçãos, e você também vai encontrar relíquias, desafios, heróis para recrutar e muitos outros tesouros!",
    "fairy.tip.5": "Cada compra deixa você mais forte, e quanto mais forte, mais longe vai chegar. Coragem! Vou cuidar de você.",
    "fairy.skip_ask": "Ei! Quer mesmo que eu fique quieta?",
    "fairy.skip_no": "Não, continue",
    "fairy.skip_yes": "Sim, pular os conselhos",
