    "weapon.sword.name": "Espada de luchador",
    "weapon.sword.desc": "Corta a los enemigos cercanos, pocos a la vez.",
    "weapon.master_sword.name": "Espada Maestra",
    "weapon.master_sword.desc": "Fusión definitiva: la espada destructora del mal. Rayos potentes y críticos.",
    "weapon.bow.name": "Arco",
    "weapon.bow.desc": "Dispara flechas a los enemigos más cercanos.",
    "weapon.silver_bow.name": "Flechas de plata",
    "weapon.silver_bow.desc": "Flechas que lo atraviesan todo.",
    "weapon.boomerang.name": "Bumerán",
    "weapon.boomerang.desc": "Va y vuelve. Aturde a quien golpea.",
    "weapon.magic_boomerang.name": "Bumerán mágico",
    "weapon.magic_boomerang.desc": "Más rápido, más ancho, aturde más.",
    "weapon.fire_rod.name": "Vara de fuego",
    "weapon.fire_rod.desc": "Bolas de fuego que incendian el suelo.",
    "weapon.bombos.name": "Medallón Bombos",
    "weapon.bombos.desc": "Columnas de fuego caen sobre la pantalla.",
    "weapon.ice_rod.name": "Vara de hielo",
    "weapon.ice_rod.desc": "Fragmentos de hielo que congelan.",
    "weapon.ether.name": "Medallón Éter",
    "weapon.ether.desc": "Golpea y congela todo a la vista.",
    "weapon.hammer.name": "Martillo mágico",
    "weapon.hammer.desc": "Golpea el suelo a tu alrededor. Aturde.",
    "weapon.quake.name": "Medallón Temblor",
    "weapon.quake.desc": "La misma tierra aplasta a tus enemigos.",
    "weapon.bombs.name": "Bombas",
    "weapon.bombs.desc": "Lanzadas a los enemigos. Gran explosión.",
    "weapon.super_bomb.name": "Superbomba",
    "weapon.super_bomb.desc": "Explosiones enormes, varias a la vez.",
    "weapon.byrna.name": "Cetro de Byrna",
    "weapon.byrna.desc": "Chispas giran a tu alrededor un rato.",
    "weapon.fairy_ring.name": "Corro de hadas",
    "weapon.fairy_ring.desc": "Hadas bailan a tu alrededor sin irse.",
    "passive.pegasus_boots.name": "Botas de Pegaso",
    "passive.pegasus_boots.desc": "Corre más rápido y más a menudo.",
