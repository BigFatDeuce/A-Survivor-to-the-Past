    "passive.heart_container.desc": "Un corazón más.",
    "passive.power_glove.name": "Guante de poder",
    "passive.power_glove.desc": "Todo el daño +10 %.",
    "passive.mirror_shield.name": "Escudo espejo",
    "passive.mirror_shield.desc": "1 de daño menos por golpe.",
    "passive.quiver.name": "Carcaj",
    "passive.quiver.desc": "Un proyectil más para cada arma.",
