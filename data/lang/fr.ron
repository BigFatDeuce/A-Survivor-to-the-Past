    "weapon.bow.desc": "Tire des flèches sur les ennemis les plus proches.",
    "weapon.silver_bow.name": "Flèches d'argent",
    "weapon.silver_bow.desc": "Des flèches qui transpercent tout.",
    "weapon.boomerang.name": "Boomerang",
    "weapon.boomerang.desc": "Part et revient. Étourdit ce qu'il touche.",
    "weapon.magic_boomerang.name": "Boomerang magique",
    "weapon.magic_boomerang.desc": "Plus rapide, plus large, étourdit plus longtemps.",
    "weapon.fire_rod.name": "Baguette de feu",
    "weapon.fire_rod.desc": "Des boules de feu qui embrasent le sol.",
    "weapon.bombos.name": "Médaillon Bombos",
    "weapon.bombos.desc": "Des colonnes de feu s'abattent à l'écran.",
    "weapon.ice_rod.name": "Baguette de glace",
    "weapon.ice_rod.desc": "Des éclats de glace qui figent les ennemis.",
    "weapon.ether.name": "Médaillon Éther",
    "weapon.ether.desc": "Frappe et gèle tout ce qui est en vue.",
    "weapon.hammer.name": "Marteau magique",
    "weapon.hammer.desc": "Frappe le sol autour de toi. Étourdit.",
    "weapon.quake.name": "Médaillon Séisme",
    "weapon.quake.desc": "La terre elle-même écrase tes ennemis.",
    "weapon.bombs.name": "Bombes",
    "weapon.bombs.desc": "Lancées sur les ennemis. Grosse explosion.",
    "weapon.super_bomb.name": "Super bombe",
    "weapon.super_bomb.desc": "Énormes explosions, plusieurs à la fois.",
    "weapon.byrna.name": "Canne de Byrna",
    "weapon.byrna.desc": "Des étincelles tournent autour de toi.",
    "weapon.fairy_ring.name": "Ronde des fées",
    "weapon.fairy_ring.desc": "Des fées dansent autour de toi sans jamais partir.",
