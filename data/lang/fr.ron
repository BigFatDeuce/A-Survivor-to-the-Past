    "weapon.sword.desc": "Tranche les ennemis proches, quelques-uns à la fois.",
    "weapon.master_sword.name": "Épée de légende",
    "weapon.master_sword.desc": "Fusion ultime : la lame purificatrice. Rayons puissants et coups critiques.",
