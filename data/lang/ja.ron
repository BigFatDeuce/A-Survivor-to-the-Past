    "weapon.sword.name": "ファイターのけん",
    "weapon.sword.desc": "ちかくの てきを きる。 いちどに すこしだけ。",
    "weapon.master_sword.name": "マスターソード",
    "weapon.master_sword.desc": "さいきょうの フュージョン。 つよい ビーム。",
    "weapon.bow.name": "ゆみ",
    "weapon.bow.desc": "ちかくの てきに やを いる。",
    "weapon.silver_bow.name": "ぎんのや",
    "weapon.silver_bow.desc": "すべてを つらぬく ぎんの や。",
    "weapon.boomerang.name": "ブーメラン",
    "weapon.boomerang.desc": "とんで もどる。 あたると しびれる。",
    "weapon.magic_boomerang.name": "マジカルブーメラン",
    "weapon.magic_boomerang.desc": "はやく ひろく ながく しびれさせる。",
    "weapon.fire_rod.name": "ファイアロッド",
    "weapon.fire_rod.desc": "じめんを もやす ひのたま。",
    "weapon.bombos.name": "ボンバーのメダル",
    "weapon.bombos.desc": "ひばしらが がめんに ふりそそぐ。",
    "weapon.ice_rod.name": "アイスロッド",
    "weapon.ice_rod.desc": "てきを こおらせる こおりの つぶて。",
    "weapon.ether.name": "エーテルのメダル",
    "weapon.ether.desc": "みえる てきを すべて こおらせる。",
    "weapon.hammer.name": "マジカルハンマー",
    "weapon.hammer.desc": "まわりの じめんを たたく。 しびれる。",
    "weapon.quake.name": "クエイクのメダル",
    "weapon.quake.desc": "だいちが てきを おしつぶす。",
    "weapon.bombs.name": "バクダン",
    "weapon.bombs.desc": "てきに なげる。 おおきな ばくはつ。",
    "weapon.super_bomb.name": "スーパーバクダン",
    "weapon.super_bomb.desc": "きょだいな ばくはつが いくつも。",
    "weapon.byrna.name": "バイラのつえ",
    "weapon.byrna.desc": "ひかりの つぶが まわりを まわる。",
    "weapon.fairy_ring.name": "ようせいの わ",
    "weapon.fairy_ring.desc": "ようせいが ずっと まわりで おどる。",
    "passive.pegasus_boots.name": "ペガサスのくつ",
    "passive.pegasus_boots.desc": "はやく はしり ダッシュも はやい。",
    "passive.heart_container.name": "ハートのうつわ",
    "passive.heart_container.desc": "ハートが ひとつ ふえる。",
    "passive.power_glove.name": "パワーグローブ",
    "passive.power_glove.desc": "すべての こうげき +10%。",
    "passive.mirror_shield.name": "ミラーシールド",
    "passive.mirror_shield.desc": "うける ダメージ -1。",
    "passive.quiver.name": "やづつ",
    "passive.quiver.desc": "すべての ぶきの かず +1。",
    "passive.half_magic.name": "ハーフマジック",
    "passive.half_magic.desc": "ぶきの クールタイム -8%。",
    "passive.lamp.name": "カンテラ",
    "passive.lamp.desc": "こうげきの はんい +10%。",
    "passive.bug_net.name": "むしとりあみ",
    "passive.bug_net.desc": "とおくの ルピーも ひきよせる。",
    "enemy.hinox": "ヒノックス",
    // 0.7.1 : conseils de la fee, deblocages sur plusieurs pages
    "fairy.tip.1": "ねえ、 そこの あなた! わたしは いずみの ようせい。 もう 2かいも まけちゃったの? だいじょうぶ、 でんせつの ゆうしゃだって たおれる ことは あるわ!",
    "fairy.tip.2": "よく きいて。 ひろった ルピーは むだに ならないの。 プレイが おわる たびに、 その いちぶが *あかい ルピーの ちょきん* に なるのよ。",
    "fairy.tip.3": "メニューの *ショップ* で つかってね! *カカリコ* では ハート、 ちから、 ぼうぎょ なんかを ずっと つよく できるわ。",
    "fairy.tip.4": "*ようせい* の しゅくふくも もらえるし、 レリック、 チャレンジ、 なかまに できる キャラ、 ほかにも たからものが いっぱい!",
    "fairy.tip.5": "かいものを するほど つよく なって、 つよく なるほど とおくまで いけるわ。 がんばって! わたしが みまもってる からね。",
    "fairy.move_pad": "ひだりスティック",
    "fairy.intro.1": "ようこそ、 ゆうしゃさま! わたしは いずみの ようせい。 しゅっぱつ する まえに、 きほんを おしえるわね。 すぐ おわるから!",
    "fairy.intro.2": "{move}で いどう。 ぶきは *じどうで* こうげき するわ! {dash}で *ダッシュ* して きけんを よけて、 {pause}で ポーズよ。",
    "fairy.intro.2_touch": "がめんの *ひだりがわ* を ゆびで なぞって いどう。 ぶきは *じどうで* こうげき するわ! *ダッシュ* を タッチして きけんを よけてね。",
    "fairy.intro.3": "*オート* なら けんが いちばん ちかい てきを かってに きるわ。 {auto}で *マニュアル* に すると、 {attack}で ねらった ほうこうに きれるの。",
    "fairy.intro.3_touch": "*オート* なら けんが いちばん ちかい てきを かってに きるわ。 *A/M* を タッチで *マニュアル* に。 みぎの ゆびで ねらって きってね。",
    "fairy.intro.4": "モンスターは *ルピー* を おとすわ。 ひろって レベルアップ、 あたらしい ぶきを えらんでね。 いきのびて *ボス* を たおし、 でぐちの ひかりへ!",
    "fairy.intro.5": "ルピーの いちぶは *ショップ* の ための ちょきんに なるわ。 だから まいかい つよく なれるの。 いってらっしゃい、 みまもってるわ!",
    "fairy.win.1": "やったわね! ガノンを たおして ハイラルは すくわれたわ! あなたは ほんものの ゆうしゃだって しんじてた!",
    "fairy.win.2": "でも ぼうけんは まだ つづくわ! *もっと むずかしい* モードに いどんでみて。 てきは つよく、 ごほうびも おおきく なるわ。",
    "fairy.win.3": "*すべての キャラクター* を かいほうして、 *ずかん* と *ギャラリー* を うめて、 オンラインの *ランキング* の トップも めざしてみて!",
    "fairy.win.4": "すくってくれて ありがとう、 ゆうしゃさま。 これからも みまもってるわ... また つぎの ぼうけんで あいましょう!",
    "ending.ganon_down": "ガノンを たおした!",
