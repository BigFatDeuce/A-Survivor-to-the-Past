    "weapon.sword.name": "Kämpferschwert",
    "weapon.sword.desc": "Schlägt nahe Gegner, ein paar auf einmal.",
    "weapon.master_sword.name": "Master-Schwert",
    "weapon.master_sword.desc": "Ultimative Fusion: die Klinge gegen das Böse. Starke Strahlen, kritische Treffer.",
    "weapon.bow.name": "Bogen",
    "weapon.bow.desc": "Schießt Pfeile auf die nächsten Gegner.",
    "weapon.silver_bow.name": "Silberpfeile",
    "weapon.silver_bow.desc": "Pfeile, die alles durchbohren.",
    "weapon.boomerang.name": "Bumerang",
    "weapon.boomerang.desc": "Fliegt hin und zurück. Betäubt Getroffene.",
    "weapon.magic_boomerang.name": "Magischer Bumerang",
    "weapon.magic_boomerang.desc": "Schneller, breiter, betäubt länger.",
    "weapon.fire_rod.name": "Feuerstab",
    "weapon.fire_rod.desc": "Feuerbälle, die den Boden entflammen.",
    "weapon.bombos.name": "Bombos-Medaillon",
    "weapon.bombos.desc": "Feuersäulen regnen auf den Bildschirm.",
    "weapon.ice_rod.name": "Eisstab",
    "weapon.ice_rod.desc": "Eissplitter, die Gegner einfrieren.",
    "weapon.ether.name": "Äther-Medaillon",
    "weapon.ether.desc": "Trifft und friert alles in Sichtweite ein.",
    "weapon.hammer.name": "Zauberhammer",
    "weapon.hammer.desc": "Schlägt auf den Boden um dich. Betäubt.",
    "weapon.quake.name": "Beben-Medaillon",
    "weapon.quake.desc": "Die Erde selbst zermalmt deine Gegner.",
    "weapon.bombs.name": "Bomben",
    "weapon.bombs.desc": "Auf Gegner geworfen. Große Explosion.",
    "weapon.super_bomb.name": "Superbombe",
    "weapon.super_bomb.desc": "Riesige Explosionen, mehrere zugleich.",
    "weapon.byrna.name": "Byrna-Stab",
    "weapon.byrna.desc": "Funken kreisen eine Weile um dich.",
    "weapon.fairy_ring.name": "Feenreigen",
    "weapon.fairy_ring.desc": "Feen tanzen um dich und bleiben.",
    "passive.pegasus_boots.name": "Pegasus-Stiefel",
    "passive.pegasus_boots.desc": "Schneller laufen, öfter sprinten.",
    "passive.heart_container.name": "Herzcontainer",
    "passive.heart_container.desc": "Ein Herz mehr.",
    "passive.power_glove.name": "Krafthandschuh",
    "passive.power_glove.desc": "Aller Schaden +10 %.",
    "passive.mirror_shield.name": "Spiegelschild",
    "passive.mirror_shield.desc": "1 Schaden weniger pro Treffer.",
    "passive.quiver.name": "Köcher",
    "passive.quiver.desc": "Ein Geschoss mehr für jede Waffe.",
    "passive.half_magic.name": "Halbe Magie",
    "passive.half_magic.desc": "Waffen laden 8 % schneller.",
    "passive.lamp.name": "Laterne",
    "passive.lamp.desc": "Angriffe 10 % größer.",
    "passive.bug_net.name": "Käfernetz",
    "passive.bug_net.desc": "Rubine kommen von weiter her.",
    "enemy.hinox": "Hinox",
    // 0.7.1 : conseils de la fee, deblocages sur plusieurs pages
    "fairy.tip.1": "He, du! Ja, du! Ich bin eine Fee aus der Quelle. Schon zwei Niederlagen? Gib nicht auf: Auch die Helden der Legende fallen manchmal!",
    "fairy.tip.2": "Hör gut zu: Die Rubine, die du sammelst, sind nie verloren. Am Ende jedes Laufs wandert ein Teil davon auf deine *Bank der roten Rubine*.",
    "fairy.tip.3": "Gib sie im *Laden* im Hauptmenü aus! In *Kakariko* stärkst du für immer deine Herzen, deine Kraft, deine Rüstung...",
    "fairy.tip.4": "Die *Große Fee* schenkt dir ihren Segen, und du findest dort auch Relikte, Herausforderungen, Helden zum Anwerben und viele andere Schätze!",
    "fairy.tip.5": "Jeder Kauf macht dich stärker, und je stärker du bist, desto weiter kommst du. Nur Mut! Ich wache über dich.",
    "fairy.skip_ask": "He! Soll ich wirklich schweigen?",
    "fairy.skip_no": "Nein, erzähl weiter",
    "fairy.skip_yes": "Ja, Tipps überspringen",
    "fairy.hint": "Bestätigen: weiter - Zurück: überspringen",
    "ui.unlocks_more": "Weiter (noch {n})",
}
