// Touches par action. Clavier : touches physiques (KeyW = Z sur un clavier AZERTY).
// Manette (gilrs) : South = A/Croix, East = B/Rond, West = X/Carre, North = Y/Triangle,
// LeftTrigger2/RightTrigger2 = gachettes. Souris : Left, Right, Middle.
// Ecran Commandes (options) : les touches choisies par le joueur (settings.ron) remplacent ces listes
// pour up, down, left, right, attack, dash, toggle_auto, zoom et pause ; les menus gardent celles-ci.
(
    actions: {
        "up":          [Key(KeyW), Key(ArrowUp), Pad(DPadUp)],
        "down":        [Key(KeyS), Key(ArrowDown), Pad(DPadDown)],
        "left":        [Key(KeyA), Key(ArrowLeft), Pad(DPadLeft)],
        "right":       [Key(KeyD), Key(ArrowRight), Pad(DPadRight)],
        "attack":      [Key(KeyJ), Mouse(Left), Pad(West), Pad(RightTrigger2)],
        "dash":        [Key(Space), Key(KeyK), Mouse(Right), Pad(South), Pad(LeftTrigger2)],
        "toggle_auto": [Key(Tab), Key(KeyR), Pad(North)],
        "pause":       [Key(Escape), Key(KeyP), Pad(Start)],
        "confirm":     [Key(Enter), Key(NumpadEnter), Key(Space), Key(KeyJ), Mouse(Left), Pad(South)],
        "back":        [Key(Escape), Key(Backspace), Mouse(Right), Pad(East)],
        "menu_up":     [Key(KeyW), Key(ArrowUp), Pad(DPadUp)],
        "menu_down":   [Key(KeyS), Key(ArrowDown), Pad(DPadDown)],
        "menu_left":   [Key(KeyA), Key(ArrowLeft), Pad(DPadLeft)],
        "menu_right":  [Key(KeyD), Key(ArrowRight), Pad(DPadRight)],
        // onglets des menus : gachettes et boutons de tranche de la manette, Q / E ou Page prec. / suiv.
        "tab_prev":    [Key(KeyQ), Key(PageUp), Pad(LeftTrigger), Pad(LeftTrigger2)],
        "tab_next":    [Key(KeyE), Key(PageDown), Pad(RightTrigger), Pad(RightTrigger2)],
        // couleur du personnage (choix du personnage) : R, Y / Triangle ; les gachettes changent d'univers
        "skin":        [Key(KeyR), Pad(North)],
        // plein ecran : Select de la manette (F11 ou Alt+Entree au clavier)
        "fullscreen":  [Pad(Select)],
        // zoom en partie (3 niveaux) : E ou bouton de tranche droit (R1 / RB) rapproche, Q ou bouton de
        // tranche gauche (L1 / LB) eloigne
        "zoom":        [Key(KeyE), Pad(RightTrigger)],
        "zoom_out":    [Key(KeyQ), Pad(LeftTrigger)],
    },
)
