// Site de presentation : fichiers statiques de site/ (generes par research/tools/make_site.py),
// servis par Cloudflare Workers sur le sous-domaine du site, et classement en ligne (/api/scores :
// worker/index.js, base D1 astp-scores). Deploiement : npx wrangler deploy
// LATEST (version du jeu) et STAGES (stages du classement) sont mis a jour par make_site.py.
{
  "name": "a-survivor-to-the-past",
  "compatibility_date": "2026-11-20",
  "main": "worker/index.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "astp-scores", "database_id": "c0bf6b92-8290-451b-8abe-daa81d5be966" }
  ],
  "vars": {
    "LATEST": "0.7.0",
    "STAGES": "hyrule_field,desert,death_mountain,hyrule_castle,dark_palace,swamp,lost_woods,thieves_town,ice_lake,pyramid",
    "MAX_MULT": "4.05"
  },
  "routes": [
    { "pattern": "a-survivor-to-the-past.holy-c.men", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
